---
import LanguageToggle from '../components/LanguageToggle.astro';

export interface Props {
    title: string;
    description: string;
    keywords?: string;
    canonical?: string;
    schema?: object[];
}

const {
    title,
    description,
    keywords = 'Bima Adam Nugraha, Ririn Setiawati, IgnitronDev founder, IgnitronDev co-founder, white-label platform, software reseller',
    canonical,
    schema = [],
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Bima Adam Nugraha, Ririn Setiawati" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#89b4fa" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${base}images/ignitron.png`} />
    <meta property="og:site_name" content="IgnitronDev" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${base}images/ignitron.png`} />
    <meta name="twitter:creator" content="@bima_yadan27" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}images/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}images/favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}images/apple-touch-icon.png`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />

    <!-- Schema JSON-LD -->
    {schema.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
</head>
<body>
    <LanguageToggle />
    <slot />
</body>
</html>
