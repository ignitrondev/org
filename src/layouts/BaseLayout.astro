---
export interface Props {
    title: string;
    description: string;
    keywords?: string;
    canonical?: string;
    schema?: object[];
    robots?: string;
    ogType?: 'website' | 'article';
    ogImage?: string;
    ogImageAlt?: string;
}

const {
    title,
    description,
    keywords = 'IgnitronDev, Bima Adam Nugraha, Founder CEO, independent technology products, software engineering solutions',
    canonical,
    schema = [],
    robots = 'index, follow',
    ogType = 'website',
    ogImage = 'images/ignitron.png',
    ogImageAlt = 'IgnitronDev',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(`${base}${ogImage.replace(/^\//, '')}`, Astro.site).href;
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <script is:inline>
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('hero-intro');
            // Never leave the hero hidden if the animation script fails to load.
            setTimeout(() => document.documentElement.classList.remove('hero-intro'), 3000);
        }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Bima Adam Nugraha, Founder & CEO of IgnitronDev" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#08080a" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="IgnitronDev" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:creator" content="@xiaobima__" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}images/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}images/favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}images/apple-touch-icon.png`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />
    <slot name="head" />

    <!-- Schema JSON-LD -->
    {schema.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
</head>
<body>
    <slot />
    <script>
        import '../scripts/scroll-animations';
    </script>
</body>
</html>
