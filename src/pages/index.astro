---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/home/HeroSection.astro';
import SignalStrip from '../components/home/SignalStrip.astro';
import EngineeringPractice from '../components/home/EngineeringPractice.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import ClientProjects from '../components/home/ClientProjects.astro';
import AboutStudio from '../components/home/AboutStudio.astro';
import '../styles.css';
import fs from 'node:fs';
import path from 'node:path';

const schemaPath = path.join(process.cwd(), 'src/data/schema.json');
const schema = JSON.parse(fs.readFileSync(schemaPath, 'utf-8'));
---

<BaseLayout
    title="IgnitronDev — Engineering Systems for the Real World"
    description="IgnitronDev is an independent engineering studio for software architecture, backend systems, cloud infrastructure, data platforms, and AI systems."
    keywords="IgnitronDev, software architecture, backend systems, cloud infrastructure, DevOps, observability, data infrastructure, AI infrastructure"
    schema={schema}
>
    <Navbar />
    <main class="main-content">
        <HeroSection />
        <SignalStrip />
        <EngineeringPractice />
        <section class="section work-section" id="work">
            <div class="container">
                <SelectedWork />
                <ClientProjects />
            </div>
        </section>
        <AboutStudio />
    </main>
    <Footer />
</BaseLayout>

<style>
    .work-section {
        background: #09090b;
    }
</style>
