---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import C from '../components/C.astro';
import '../styles.css';
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL;
const schemaPath = path.join(process.cwd(), 'src/data/schema.json');
const schema = JSON.parse(fs.readFileSync(schemaPath, 'utf-8'));
---

<BaseLayout
    title="IgnitronDev — Independent Products"
    description="IgnitronDev builds IgnitronDev Router, ShipRadar, and Ignitron Clinical UI."
    keywords="IgnitronDev, IgnitronDev Router, AI gateway, AI router, unified AI API, ShipRadar, open source developer tools, Ignitron Clinical UI"
    schema={schema}
>
    <Navbar />
    <main class="main-content">
        <section class="studio-hero" id="hero">
            <div class="hero-grid-bg" aria-hidden="true"></div>
            <div class="container studio-hero-grid">
                <div class="studio-hero-copy">
                    <div class="hero-badge"><span class="status-dot"></span><C en="Independent products" id="Produk independen" zh="独立产品" /></div>
                    <h1><C en="Products for real work." id="Produk untuk pekerjaan nyata." zh="为真实工作而生的产品。" /><br /><span class="text-gradient"><C en="Tools for builders." id="Tools untuk para builder." zh="为构建者而生的工具。" /></span></h1>
                    <p class="studio-hero-subtitle"><C en="IgnitronDev builds and operates IgnitronDev Router, ShipRadar, and Ignitron Clinical UI. Each product serves its own users, solves a specific problem, and follows its own roadmap." id="IgnitronDev membangun dan mengoperasikan IgnitronDev Router, ShipRadar, serta Ignitron Clinical UI. Setiap produk melayani penggunanya sendiri, menyelesaikan masalah spesifik, dan memiliki roadmap masing-masing." zh="IgnitronDev 构建并运营 IgnitronDev Router、ShipRadar 与 Ignitron Clinical UI。每个产品服务各自的用户、解决具体问题，并拥有独立的路线图。" /></p>
                    <div class="hero-cta">
                        <a href="#work" class="btn btn-primary btn-lg"><C en="Explore our work" id="Lihat karya kami" zh="浏览我们的作品" /></a>
                        <a href="https://github.com/ignitrondev" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-lg">GitHub ↗</a>
                    </div>
                </div>

                <aside class="studio-index" aria-label="Current IgnitronDev work">
                    <header><span>CURRENT WORK</span><span>3 ACTIVE BUILDS</span></header>
                    <a href="https://shipradar.my.id" target="_blank" rel="noopener noreferrer" class="index-row">
                        <span class="index-number">01</span>
                        <span><b>ShipRadar</b><small><C en="Maritime software product" id="Produk software maritim" zh="海事软件产品" /></small></span>
                        <span class="index-state live"><i></i> LIVE</span>
                    </a>
                    <a href="https://app.ignitrondev.space" target="_blank" rel="noopener noreferrer" class="index-row">
                        <span class="index-number">02</span>
                        <span><b>IgnitronDev Router</b><small><C en="Unified AI model gateway" id="Gateway model AI terpadu" zh="统一 AI 模型网关" /></small></span>
                        <span class="index-state live"><i></i> LIVE</span>
                    </a>
                    <a href="https://ignitron-medic-ui.pages.dev/" target="_blank" rel="noopener noreferrer" class="index-row">
                        <span class="index-number">03</span>
                        <span><b>Ignitron Clinical UI</b><small><C en="Open-source component library" id="Library komponen open-source" zh="开源组件库" /></small></span>
                        <span class="index-state"><i></i> ALPHA</span>
                    </a>
                    <footer><span>PRODUCTS</span><span>+</span><span>OPEN SOURCE</span></footer>
                </aside>
            </div>
        </section>

        <section class="signal-strip" aria-label="IgnitronDev capabilities">
            <div class="container signal-grid">
                <span>PRODUCT ENGINEERING</span><span>AI INFRASTRUCTURE</span><span>OPEN SOURCE</span><span>WEB SOFTWARE</span>
            </div>
        </section>

        <section class="section work-section" id="work">
            <div class="container">
                <div class="section-header work-header">
                    <div>
                        <span class="section-badge"><C en="Selected work" id="Karya pilihan" zh="精选作品" /></span>
                        <h2 class="section-title"><C en="Different users." id="Pengguna berbeda." zh="不同的用户。" /> <span class="text-gradient"><C en="Focused products." id="Produk yang fokus." zh="专注的产品。" /></span></h2>
                    </div>
                    <p class="section-subtitle"><C en="IgnitronDev Router unifies access to leading AI models. ShipRadar follows vessel movements. Ignitron Clinical UI gives healthcare developers stronger building blocks." id="IgnitronDev Router menyatukan akses ke berbagai model AI terdepan. ShipRadar mengikuti pergerakan kapal. Ignitron Clinical UI memberi developer healthcare building block yang lebih kuat." zh="IgnitronDev Router 统一接入领先 AI 模型，ShipRadar 追踪船舶动态，Ignitron Clinical UI 为医疗软件开发者提供更强的构建基础。" /></p>
                </div>

                <div class="work-grid">
                    <article class="work-card product-card" id="products">
                        <div class="work-card-copy">
                            <div class="work-meta"><span>PRODUCT / 01</span><span class="work-status live"><i></i> LIVE</span></div>
                            <div>
                                <p class="work-eyebrow">MARITIME SOFTWARE</p>
                                <h3>ShipRadar</h3>
                                <p><C en="A maritime vessel-tracking platform for monitoring ships, routes, and fleet activity through a focused operational interface." id="Platform pelacakan kapal untuk memantau kapal, rute, dan aktivitas armada melalui interface operasional yang terfokus." zh="面向船舶、航线与船队活动监控的海事追踪平台，提供专注的运营界面。" /></p>
                            </div>
                            <div class="work-tags"><span>Vessel tracking</span><span>AIS data</span><span>Fleet operations</span></div>
                            <a href="https://shipradar.my.id" target="_blank" rel="noopener noreferrer" class="work-link"><C en="Visit ShipRadar" id="Kunjungi ShipRadar" zh="访问 ShipRadar" /> <span>↗</span></a>
                        </div>
                        <div class="radar-visual" aria-hidden="true">
                            <div class="radar-grid"></div>
                            <div class="radar-ring ring-one"></div><div class="radar-ring ring-two"></div><div class="radar-ring ring-three"></div>
                            <div class="radar-axis horizontal"></div><div class="radar-axis vertical"></div>
                            <div class="radar-sweep-line"></div>
                            <i class="vessel vessel-one"></i><i class="vessel vessel-two"></i><i class="vessel vessel-three"></i>
                            <span class="radar-label top">06°12' S</span><span class="radar-label bottom">106°49' E</span>
                        </div>
                    </article>

                    <article class="work-card router-card">
                        <div class="work-card-copy">
                            <div class="work-meta"><span>PRODUCT / 02</span><span class="work-status live"><i></i> LIVE</span></div>
                            <div>
                                <p class="work-eyebrow">AI INFRASTRUCTURE</p>
                                <h3>IgnitronDev Router</h3>
                                <p><C en="A unified AI gateway for routing requests to leading models through one API key, with built-in usage metering, billing, and spend controls." id="Gateway AI terpadu untuk merutekan request ke model terdepan melalui satu API key, dilengkapi metering penggunaan, billing, dan kontrol biaya." zh="统一 AI 网关，通过一个 API 密钥将请求路由至领先模型，并内置用量计量、账单与费用控制。" /></p>
                            </div>
                            <div class="work-tags"><span>AI gateway</span><span>Unified API</span><span>Usage metering</span><span>Spend controls</span></div>
                            <a href="https://app.ignitrondev.space" target="_blank" rel="noopener noreferrer" class="work-link"><C en="Open IgnitronDev Router" id="Buka IgnitronDev Router" zh="打开 IgnitronDev Router" /> <span>↗</span></a>
                        </div>
                        <div class="router-visual" aria-hidden="true">
                            <div class="router-console">
                                <header><span>AI ROUTER / LIVE</span><span class="router-live"><i></i> OPERATIONAL</span></header>
                                <div class="router-request"><span>POST</span><code>/v1/messages</code><small>ONE API KEY</small></div>
                                <div class="router-flow">
                                    <div class="router-source"><small>YOUR APP</small><strong>REQUEST</strong></div>
                                    <div class="router-path"><i></i><i></i><i></i></div>
                                    <div class="router-core"><small>IGNITRONDEV</small><strong>ROUTER</strong><span>AUTH · ROUTE · METER</span></div>
                                    <div class="router-path outbound"><i></i><i></i><i></i></div>
                                    <div class="router-models"><span>ANTHROPIC</span><span>OPENAI</span><span>GOOGLE</span></div>
                                </div>
                                <footer><span><b>1</b><small>endpoint</small></span><span><b>1</b><small>API key</small></span><span><b>∞</b><small>possibilities</small></span></footer>
                            </div>
                        </div>
                    </article>

                    <article class="work-card open-source-card" id="open-source">
                        <div class="work-card-copy">
                            <div class="work-meta"><span>OPEN SOURCE / 01</span><span class="work-status"><i></i> ALPHA</span></div>
                            <div>
                                <p class="work-eyebrow">CLINICAL SOFTWARE INFRASTRUCTURE</p>
                                <h3>Ignitron Clinical UI</h3>
                                <p><C en="Reusable React components for difficult clinical workflows, built around explicit data contracts and clear integration boundaries." id="Komponen React reusable untuk workflow klinis yang sulit, dibangun di atas kontrak data eksplisit dan batas integrasi yang jelas." zh="面向复杂临床工作流的可复用 React 组件，采用显式数据契约与清晰集成边界。" /></p>
                            </div>
                            <div class="work-tags"><span>React</span><span>TypeScript</span><span>Clinical data</span><span>Apache-2.0</span></div>
                            <div class="work-actions">
                                <a href="https://ignitron-medic-ui.pages.dev/" target="_blank" rel="noopener noreferrer" class="work-link"><C en="Read the docs" id="Buka dokumentasi" zh="阅读文档" /> <span>↗</span></a>
                                <a href="https://www.npmjs.com/package/@ignitrondev/odontogram" target="_blank" rel="noopener noreferrer" class="work-link muted">npm ↗</a>
                            </div>
                        </div>
                        <div class="package-visual" aria-label="Odontogram package installation example">
                            <header><span>PACKAGE / ALPHA</span><span>PUBLIC</span></header>
                            <div class="package-name"><small>@ignitrondev/</small><strong>odontogram</strong></div>
                            <div class="package-command"><span>$</span><code>npm install @ignitrondev/odontogram@alpha</code></div>
                            <div class="package-stats"><span><b>React</b><small>18 / 19</small></span><span><b>ESM</b><small>typed</small></span><span><b>0</b><small>telemetry</small></span></div>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="section studio-section" id="approach">
            <div class="container studio-grid">
                <div class="studio-statement">
                    <span class="section-badge"><C en="Product approach" id="Pendekatan produk" zh="产品方法" /></span>
                    <h2><C en="Each product" id="Setiap produk" zh="每个产品" /><br /><span class="text-gradient"><C en="stands on its own." id="berdiri sendiri." zh="独立存在。" /></span></h2>
                    <p><C en="IgnitronDev Router, ShipRadar, and Ignitron Clinical UI are built for different people and different workflows. We give each product its own identity, roadmap, and measure of success." id="IgnitronDev Router, ShipRadar, dan Ignitron Clinical UI dibangun untuk pengguna dan workflow yang berbeda. Setiap produk memiliki identitas, roadmap, dan ukuran keberhasilannya sendiri." zh="IgnitronDev Router、ShipRadar 与 Ignitron Clinical UI 面向不同用户与工作流。每个产品都有自己的身份、路线图与成功标准。" /></p>
                </div>
                <div class="studio-principles">
                    <article><span>01</span><div><h3><C en="Start with the workflow" id="Mulai dari workflow" zh="从工作流开始" /></h3><p><C en="Understand the real job before choosing the interface or stack." id="Pahami pekerjaan nyata sebelum memilih interface atau stack." zh="在选择界面或技术栈前，先理解真实任务。" /></p></div></article>
                    <article><span>02</span><div><h3><C en="Build clear boundaries" id="Bangun batas yang jelas" zh="建立清晰边界" /></h3><p><C en="Products should be explicit about what they own and what stays with the user." id="Produk harus jelas tentang apa yang dikelola dan apa yang tetap dimiliki pengguna." zh="产品应明确自身职责，以及哪些内容始终归用户所有。" /></p></div></article>
                    <article><span>03</span><div><h3><C en="Ship, learn, improve" id="Rilis, belajar, perbaiki" zh="发布、学习、改进" /></h3><p><C en="Useful software grows through real usage, not a long list of speculative features." id="Software yang berguna tumbuh lewat penggunaan nyata, bukan daftar panjang fitur spekulatif." zh="有用的软件源于真实使用，而不是冗长的假设功能清单。" /></p></div></article>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</BaseLayout>

<style>
    .studio-hero { min-height: 100vh; display: flex; align-items: center; position: relative; overflow: hidden; padding: 150px 0 90px; }
    .hero-grid-bg { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(to bottom, black, transparent 90%); }
    .studio-hero::before { content: ''; position: absolute; width: 620px; height: 620px; border-radius: 50%; background: rgba(255,255,255,.055); filter: blur(150px); top: -310px; left: 8%; }
    .studio-hero-grid { position: relative; display: grid; grid-template-columns: 1.08fr .92fr; gap: 80px; align-items: center; }
    .hero-badge { width: fit-content; display: flex; align-items: center; gap: 9px; padding: 7px 13px; border: 1px solid var(--border-color); background: rgba(24,24,27,.75); color: var(--cyber-cyan-dark); font: 600 11px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 26px; }
    .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 9px rgba(74,222,128,.6); display: inline-block; }
    .studio-hero-copy > * { opacity: 0; transform: translateY(18px); animation: hero-rise .72s cubic-bezier(.16,1,.3,1) forwards; }
    .studio-hero-copy > :nth-child(1) { animation-delay: .08s; }.studio-hero-copy > :nth-child(2) { animation-delay: .16s; }.studio-hero-copy > :nth-child(3) { animation-delay: .24s; }.studio-hero-copy > :nth-child(4) { animation-delay: .32s; }
    .studio-hero h1 { font-size: clamp(50px, 6.3vw, 84px); line-height: .98; letter-spacing: -.055em; max-width: 860px; }
    .studio-hero-subtitle { color: #a1a1aa; font-size: clamp(17px, 1.7vw, 20px); line-height: 1.7; max-width: 720px; margin: 30px 0 34px; }
    .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; }
    .studio-index { position: relative; overflow: hidden; border: 1px solid #3f3f46; background: rgba(9,9,11,.9); box-shadow: 0 40px 100px rgba(0,0,0,.55); opacity: 0; transform: translate3d(24px,18px,0) scale(.985); animation: index-arrive .9s .2s cubic-bezier(.16,1,.3,1) forwards; }
    .studio-index::before { content: ''; position: absolute; z-index: 2; inset: -35% 0 auto; height: 35%; pointer-events: none; background: linear-gradient(to bottom,transparent,rgba(255,255,255,.045),transparent); animation: index-scan 5.5s 1.35s ease-in-out infinite; }
    .studio-index::after { content: ''; position: absolute; z-index: 3; left: 0; top: 0; width: 42%; height: 1px; pointer-events: none; background: linear-gradient(90deg,transparent,#f4f4f5,transparent); transform: translateX(-120%); animation: index-glint 6s 1.1s ease-in-out infinite; }
    .studio-index > header,.studio-index > footer { display: flex; justify-content: space-between; padding: 14px 18px; color: #71717a; font: 10px var(--font-mono); letter-spacing: .08em; border-bottom: 1px solid #27272a; }
    .studio-index > header { opacity: 0; animation: row-reveal .55s .55s ease-out forwards; }
    .studio-index > header span:first-child::before { content: ''; width: 6px; height: 6px; border-radius: 50%; display: inline-block; margin-right: 8px; background: #a1a1aa; animation: header-blink 2.8s ease-in-out infinite; }
    .studio-index > footer { border: 0; border-top: 1px solid #27272a; justify-content: flex-start; gap: 12px; }
    .studio-index > footer { opacity: 0; animation: row-reveal .55s .94s ease-out forwards; }
    .index-row { position: relative; display: grid; grid-template-columns: 34px 1fr auto; gap: 15px; align-items: center; padding: 24px 18px; border-bottom: 1px solid #27272a; opacity: 0; transform: translateX(14px); transition: background .25s ease,box-shadow .25s ease; animation: row-reveal .62s cubic-bezier(.16,1,.3,1) forwards; }
    .index-row:nth-of-type(1) { animation-delay: .66s; }.index-row:nth-of-type(2) { animation-delay: .8s; }.index-row:nth-of-type(3) { animation-delay: .94s; }
    .index-row:hover { background: #18181b; box-shadow: inset 2px 0 #d4d4d8; }
    .index-row:focus-visible { outline: 1px solid #d4d4d8; outline-offset: -3px; background: #18181b; }
    .index-number { color: #52525b; font: 11px var(--font-mono); }
    .index-row b { display: block; font-size: 18px; margin-bottom: 4px; transition: transform .25s ease,color .25s ease; }.index-row:hover b { color: #fff; transform: translateX(4px); }.index-row small { color: #71717a; }
    .index-state { color: #a1a1aa; font: 9px var(--font-mono); letter-spacing: .08em; }.index-state i,.work-status i { width: 6px; height: 6px; border-radius: 50%; background: #a1a1aa; display: inline-block; margin-right: 5px; }.index-state i { animation: status-pulse 2.4s ease-in-out infinite; }.index-row:nth-of-type(2) .index-state i { animation-delay: .7s; }.index-state.live i,.work-status.live i { background: #4ade80; box-shadow: 0 0 7px rgba(74,222,128,.5); }
    .signal-strip { border-block: 1px solid #27272a; background: #0c0c0f; }
    .signal-grid { min-height: 70px; display: grid; grid-template-columns: repeat(4, 1fr); align-items: center; text-align: center; color: #71717a; font: 10px var(--font-mono); letter-spacing: .12em; }
    .signal-grid span + span { border-left: 1px solid #27272a; }
    .work-section { background: #09090b; }
    .work-header { display: grid; grid-template-columns: 1fr .72fr; gap: 80px; align-items: end; }
    .work-grid { display: grid; gap: 22px; }
    .work-card { min-width:0;min-height:540px;display:grid;grid-template-columns:1.05fr .95fr;border:1px solid #27272a;background:#0c0c0f;overflow:hidden;scroll-margin-top:110px; }
    .work-card-copy { min-width:0;padding:36px;display:flex;flex-direction:column;justify-content:space-between;gap:40px; }
    .work-meta { display: flex; justify-content: space-between; color: #71717a; font: 10px var(--font-mono); letter-spacing: .1em; }
    .work-status { color: #a1a1aa; }
    .work-eyebrow { color: #71717a !important; font: 10px var(--font-mono); letter-spacing: .14em; margin-bottom: 10px; }
    .work-card h3 { font-size: clamp(40px, 5vw, 68px); letter-spacing: -.055em; line-height: 1; margin-bottom: 18px; }
    .work-card p { color: #a1a1aa; font-size: 16px; line-height: 1.75; max-width: 690px; }
    .work-tags { display: flex; gap: 8px; flex-wrap: wrap; }.work-tags span { border: 1px solid #3f3f46; padding: 6px 10px; color: #71717a; font: 10px var(--font-mono); }
    .work-link { width: fit-content; display: inline-flex; align-items: center; gap: 10px; border-bottom: 1px solid #a1a1aa; padding-bottom: 5px; font-weight: 600; }.work-link span { transition: transform .2s ease; }.work-link:hover span { transform: translate(3px,-3px); }.work-link.muted { color: #a1a1aa; }
    .work-actions { display: flex; gap: 22px; flex-wrap: wrap; }
    .radar-visual { position:relative;min-width:0;min-height:540px;overflow:hidden;background:#101014;border-left:1px solid #27272a; }
    .radar-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px); background-size: 32px 32px; }
    .radar-ring { position: absolute; left: 50%; top: 50%; border: 1px solid #3f3f46; border-radius: 50%; transform: translate(-50%,-50%); animation: ring-pulse 4s ease-in-out infinite; }.ring-one{width:180px;height:180px;animation-delay:0s}.ring-two{width:330px;height:330px;animation-delay:1.3s}.ring-three{width:480px;height:480px;animation-delay:2.6s}
    .radar-axis { position: absolute; background: #3f3f46; }.radar-axis.horizontal{height:1px;left:0;right:0;top:50%}.radar-axis.vertical{width:1px;top:0;bottom:0;left:50%}
    .vessel { position: absolute; width: 8px; height: 13px; border: 1px solid #f4f4f5; background: #27272a; clip-path: polygon(50% 0,100% 35%,80% 100%,20% 100%,0 35%); }.vessel-one{left:67%;top:31%}.vessel-two{left:29%;top:62%}.vessel-three{left:57%;top:72%}
    .radar-label { position: absolute; color:#52525b;font:9px var(--font-mono);letter-spacing:.08em}.radar-label.top{top:18px;left:18px}.radar-label.bottom{bottom:18px;right:18px}
    .router-visual { min-width:0;min-height:540px;display:grid;place-items:center;padding:36px;overflow:hidden;background:#101014;border-left:1px solid #27272a;background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);background-size:32px 32px; }
    .router-console { width:100%;max-width:560px;border:1px solid #3f3f46;background:rgba(9,9,11,.96);box-shadow:0 30px 70px rgba(0,0,0,.5);font-family:var(--font-mono); }
    .router-console header { display:flex;justify-content:space-between;gap:16px;padding:14px 16px;border-bottom:1px solid #27272a;color:#71717a;font-size:10px;letter-spacing:.08em; }
    .router-live { color:#a1a1aa; }.router-live i { width:6px;height:6px;display:inline-block;margin-right:5px;border-radius:50%;background:#4ade80;box-shadow:0 0 7px rgba(74,222,128,.5);animation:status-pulse 2.4s ease-in-out infinite; }
    .router-request { display:flex;align-items:center;gap:10px;margin:22px;padding:13px 14px;border:1px solid #27272a;background:#18181b;font-size:11px; }.router-request>span{color:#09090b;background:#f4f4f5;padding:3px 6px;font-weight:700}.router-request code{color:#d4d4d8}.router-request small{margin-left:auto;color:#52525b;letter-spacing:.08em}
