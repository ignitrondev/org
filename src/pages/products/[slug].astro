---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import C from '../../components/C.astro';
import { products, productPath, type Product } from '../../data/products';
import '../../styles.css';

export function getStaticPaths() {
    return products.map((product) => ({
        params: { slug: product.slug },
        props: { product },
    }));
}

interface Props {
    product: Product;
}

const { product } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageURL = new URL(`${base}products/${product.slug}/`, Astro.site).href;
const others = products.filter((item) => item.slug !== product.slug);

const schema = [
    {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        '@id': `${pageURL}#page`,
        url: pageURL,
        name: `${product.name} — IgnitronDev`,
        description: product.summary.en,
        about: { '@id': product.schemaId },
        isPartOf: { '@id': 'https://ignitrondev.space/#organization' },
    },
];
---

<BaseLayout
    title={`${product.name} — IgnitronDev`}
    description={product.summary.en}
    keywords={`${product.name}, IgnitronDev, ${product.tags.join(', ')}`}
    schema={[schema]}
>
    <Navbar />
    <main class="main-content">
        <section class="page-hero">
            <div class="container">
                <p class="sec-kicker">
                    <b>[{product.index}]</b>
                    <a href={`${base}products/`}><C en="Products" id="Produk" zh="产品" /></a>
                </p>
                <h1>{product.name}</h1>
                <p class="product-status"><span class:list={['work-status', { live: product.status !== 'alpha' }]}><i></i>{product.statusLabel}</span><span>{product.eyebrow}</span></p>
                <p><C en={product.summary.en} id={product.summary.id} zh={product.summary.zh} /></p>
                <div class="product-actions">
                    {product.links.map((link, index) => (
                        <a
                            href={link.external ? link.href : `${base}${link.href.replace(/^\//, '')}`}
                            class:list={['btn', index === 0 ? 'btn-primary' : 'btn-outline']}
                            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                        >
                            <C en={link.label.en} id={link.label.id} zh={link.label.zh} />
                            <span class="btn-arrow" aria-hidden="true">{link.external ? '↗' : '→'}</span>
                        </a>
                    ))}
                </div>
                <div class="tag-list" aria-label="Topics">
                    {product.tags.map((tag) => <span>{tag}</span>)}
                </div>
            </div>
        </section>

        <section class="product-more">
            <div class="container">
                <h2><C en="Other products" id="Produk lain" zh="其他产品" /></h2>
                <ul>
                    {others.map((item) => (
                        <li><a href={`${base}${productPath(item.slug).slice(1)}`}><span>{item.index}</span>{item.name}</a></li>
                    ))}
                </ul>
            </div>
        </section>
    </main>
    <Footer />
</BaseLayout>

<style>
    .sec-kicker :global(a:hover) {
        color: var(--accent);
    }

    .product-actions :global(.btn-primary) {
        color: var(--bg);
    }

    .product-actions :global(.btn-outline) {
        color: var(--text);
    }

    .product-status {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 18px;
        color: var(--text-3);
        font: 500 11px/1 var(--font-mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .work-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--text-2);
    }

    .work-status i {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--text-3);
    }

    .work-status.live {
        color: var(--ok);
    }

    .work-status.live i {
        background: var(--ok);
        box-shadow: 0 0 8px rgba(74, 222, 128, 0.6);
    }

    .product-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    .tag-list {
        margin-top: 28px;
    }

    .product-more {
        padding: var(--section-padding) 0;
        border-top: 1px solid var(--line);
    }

    .product-more h2 {
        margin-bottom: 8px;
        color: var(--text-3);
        font: 500 11px/1 var(--font-mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .product-more a {
        display: flex;
        align-items: baseline;
        gap: 16px;
        padding: 18px 0;
        border-bottom: 1px solid var(--line);
        font-size: 22px;
        font-weight: 600;
        letter-spacing: -0.04em;
    }

    .product-more a span {
        color: var(--text-3);
        font: 500 11px/1 var(--font-mono);
        letter-spacing: 0.12em;
    }

    .product-more a:hover {
        color: var(--accent);
    }

    @media (max-width: 640px) {
        .product-actions .btn {
            width: 100%;
        }
    }
</style>
