---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import C from '../../components/C.astro';
import { products, productPath } from '../../data/products';
import '../../styles.css';

const base = import.meta.env.BASE_URL;
const pageURL = new URL(`${base}products/`, Astro.site).href;

const schema = [
    {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        '@id': `${pageURL}#page`,
        url: pageURL,
        name: 'Products — IgnitronDev',
        description: 'Independent products and open-source building blocks from IgnitronDev: ShipRadar, Ignitron Clinical UI, IGN Volcano, FocusFlow, and Ignitron UI.',
        isPartOf: { '@id': 'https://ignitrondev.space/#organization' },
        mainEntity: {
            '@type': 'ItemList',
            itemListElement: products.map((product, position) => ({
                '@type': 'ListItem',
                position: position + 1,
                name: product.name,
                url: new URL(`${base}products/${product.slug}/`, Astro.site).href,
            })),
        },
    },
];
---

<BaseLayout
    title="Products — IgnitronDev"
    description="Independent products and open-source building blocks from IgnitronDev: ShipRadar, Ignitron Clinical UI, IGN Volcano, FocusFlow, and Ignitron UI."
    keywords="IgnitronDev products, ShipRadar, IGN Volcano, FocusFlow, Ignitron Clinical UI, Ignitron UI, @ignitrondev/ui"
    schema={[schema]}
>
    <Navbar />
    <main class="main-content">
        <section class="page-hero">
            <div class="container">
                <p class="sec-kicker"><b>[WORK]</b><C en="Products" id="Produk" zh="产品" /></p>
                <h1><C en="What we" id="Apa yang" zh="我们" /> <span class="text-gradient"><C en="run." id="kami jalankan." zh="运行的事物。" /></span></h1>
                <p><C en="Independent products and open-source building blocks. Each one has a page on this domain. The running application, when there is one, stays on its own address." id="Produk independen dan building block open-source. Masing-masing punya halaman di domain ini. Aplikasi yang sudah berjalan, kalau ada, tetap di alamatnya sendiri." zh="独立产品与开源构件。每一项都在本域名下有自己的页面。已经上线的应用仍保留各自的地址。" /></p>
            </div>
        </section>

        <section class="product-index" aria-label="Products">
            <div class="container">
                <ol>
                    {products.map((product) => (
                        <li>
                            <a href={`${base}${productPath(product.slug).slice(1)}`}>
                                <span class="product-index-no">{product.index}</span>
                                <span class="product-index-copy">
                                    <span class="product-index-meta">
                                        <span>{product.eyebrow}</span>
                                        <span class:list={['work-status', { live: product.status !== 'alpha' }]}><i></i>{product.statusLabel}</span>
                                    </span>
                                    <strong>{product.name}</strong>
                                    <C en={product.summary.en} id={product.summary.id} zh={product.summary.zh} />
                                    <span class="tag-list">{product.tags.map((tag) => <span>{tag}</span>)}</span>
                                </span>
                                <span class="product-index-go" aria-hidden="true">→</span>
                            </a>
                        </li>
                    ))}
                </ol>
            </div>
        </section>
    </main>
    <Footer />
</BaseLayout>

<style>
    .product-index {
        padding: 28px 0 var(--section-padding);
    }

    .product-index ol {
        border-top: 1px solid var(--line);
    }

    .product-index a {
        display: grid;
        grid-template-columns: 72px minmax(0, 1fr) auto;
        gap: 28px;
        align-items: start;
        padding: 32px 0;
        border-bottom: 1px solid var(--line);
        transition: color var(--transition-fast);
    }

    .product-index a:hover strong {
        color: var(--accent);
    }

    .product-index-no,
    .product-index-meta,
    .product-index-go {
        color: var(--text-3);
        font: 500 11px/1 var(--font-mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .product-index-no {
        padding-top: 6px;
    }

    .product-index-meta {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 14px;
    }

    .work-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--text-2);
    }

    .work-status i {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--text-3);
    }

    .work-status.live {
        color: var(--ok);
    }

    .work-status.live i {
        background: var(--ok);
        box-shadow: 0 0 8px rgba(74, 222, 128, 0.6);
    }

    .product-index strong {
        display: block;
        margin-bottom: 12px;
        font-size: clamp(32px, 4vw, 48px);
        font-weight: 600;
        letter-spacing: -0.05em;
        line-height: 1;
        transition: color var(--transition-fast);
    }

    .product-index-copy :global([data-i18n]) {
        display: block;
        max-width: 640px;
        color: var(--text-2);
        font-size: 16px;
        line-height: 1.7;
        letter-spacing: 0;
        text-transform: none;
    }

    .product-index .tag-list {
        margin-top: 18px;
    }

    .product-index-go {
        padding-top: 8px;
        font-size: 18px;
        letter-spacing: 0;
        transition: transform var(--transition-fast), color var(--transition-fast);
    }

    .product-index a:hover .product-index-go {
        color: var(--accent);
        transform: translateX(4px);
    }

    @media (max-width: 700px) {
        .product-index a {
            grid-template-columns: 1fr auto;
            gap: 12px 16px;
            padding: 24px 0;
        }

        .product-index-no {
            grid-column: 1 / -1;
            padding-top: 0;
        }

        .product-index strong {
            font-size: 32px;
        }
    }
</style>
