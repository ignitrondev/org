---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import '../styles.css';

const base = import.meta.env.BASE_URL;

const schema = [
    {
        "@context": "https://schema.org",
        "@graph": [
            { "@type": "Blog", "@id": "https://ignitrondev.space/blog#blog", "name": "IgnitronDev Blog", "description": "Notes on clinical UI, healthcare engineering, product development, and atmospheric phonk.", "url": "https://ignitrondev.space/blog/", "publisher": { "@id": "https://ignitrondev.space/#organization" }, "author": [{ "@id": "https://ignitrondev.space/#bima" }], "associatedMedia": [{ "@id": "https://ignitrondev.space/blog#youtube-playlist" }, { "@id": "https://ignitrondev.space/blog#spotify-playlist" }] },
            { "@type": "MusicPlaylist", "@id": "https://ignitrondev.space/blog#youtube-playlist", "name": "Atmospheric Phonk Wave — 夜のドリフト", "url": "https://music.youtube.com/playlist?list=PL1iO-6XxwzsI_Kg4v9yfC3PfsVa77fpte", "creator": { "@id": "https://ignitrondev.space/#bima" } },
            { "@type": "MusicPlaylist", "@id": "https://ignitrondev.space/blog#spotify-playlist", "name": "Atmospheric Phonk Wave — 夜のドリフト", "url": "https://open.spotify.com/playlist/2noGfli9DsoQpf81dD5H7R", "creator": { "@id": "https://ignitrondev.space/#bima" } },
            { "@type": "Person", "@id": "https://ignitrondev.space/#bima", "name": "Bima Adam Nugraha", "jobTitle": "Founder & CEO of IgnitronDev", "sameAs": ["https://instagram.com/xiaobima__"] }
        ]
    }
];

const allBlogPosts = await getCollection('blog');
const posts = allBlogPosts
    .map(post => ({
        ...post.data,
        slug: post.id,
        dateFormatted: post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
    }))
    .sort((a, b) => b.date.valueOf() - a.date.valueOf())
    .map((post, i) => ({ ...post, index: String(i + 1).padStart(2, '0') }));
---

<BaseLayout
    title="IgnitronDev Blog — Clinical UI, Healthcare Engineering & Product Notes"
    description="Notes from IgnitronDev about clinical UI, healthcare software engineering, and product development. Listen to Bima's atmospheric phonk playlist, Atmospheric Phonk Wave, on YouTube Music."
    keywords="IgnitronDev blog, clinical UI, healthcare software engineering, medical UI components, product development, atmospheric phonk playlist, Beatz Bimz, YouTube Music"
    schema={schema}
>
    <Navbar />
    <main class="main-content">

        <!-- Hero -->
        <section class="page-hero">
            <div class="container">
                <p class="sec-kicker"><b>[BLOG]</b>Notes &amp; stories</p>
                <h1>Insights &amp; <span class="text-gradient">stories.</span></h1>
                <p>Technology, innovation, and the journey behind IgnitronDev.</p>
            </div>
        </section>

        <!-- Posts -->
        <section class="blog-section">
            <div class="container">

                <!-- Filters -->
                <div class="blog-filters" id="blogFilters">
                    <button class="bp-filter active" data-filter="all">All</button>
                    <button class="bp-filter" data-filter="story">Story</button>
                    <button class="bp-filter" data-filter="personal">Music</button>
                    <button class="bp-filter" data-filter="technology">Tech</button>
                    <button class="bp-filter" data-filter="company">Company</button>
                </div>

                <!-- Grid -->
                <div class="bp-grid" id="blogGrid">
                    {posts.map(post => (
                        <article class={`bp-card${post.featured ? ' is-featured' : ''}`} data-category={post.category}>
                            <a href={`${base}blog/${post.slug}`} class="bp-card-link">
                                <div class="bp-card-top">
                                    <span class="bp-card-index">{post.index}</span>
                                    <span class="bp-card-label" style={`color: ${post.color};`}>{post.label}</span>
                                    {post.featured && <span class="bp-card-flag">Featured</span>}
                                    <time class="bp-card-date">{post.dateFormatted}</time>
                                </div>
                                <h2 class="bp-card-title">{post.title}</h2>
                                <p class="bp-card-excerpt">{post.excerpt}</p>
                                <span class="bp-card-more">Read <span>→</span></span>
                            </a>
                        </article>
                    ))}
                </div>

                <p class="bp-playlist-note">Working soundtrack: <a href="https://music.youtube.com/playlist?list=PL1iO-6XxwzsI_Kg4v9yfC3PfsVa77fpte" target="_blank" rel="noopener noreferrer">Atmospheric Phonk Wave — 夜のドリフト</a> on YouTube Music and Spotify. The story is in <a href={`${base}blog/music-and-life/`}>why Bima loves atmospheric phonk</a>.</p>

                <aside class="bp-spotify">
                    <header>
                        <span>MUSIC / YOUTUBE MUSIC</span>
                        <a href="https://music.youtube.com/playlist?list=PL1iO-6XxwzsI_Kg4v9yfC3PfsVa77fpte" target="_blank" rel="noopener noreferrer">Open playlist ↗</a>
                    </header>
                    <iframe src="https://www.youtube-nocookie.com/embed/videoseries?list=PL1iO-6XxwzsI_Kg4v9yfC3PfsVa77fpte" width="100%" height="352" style="border:0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen loading="lazy" title="Atmospheric Phonk Wave by Bima Adam Nugraha on YouTube Music"></iframe>
                </aside>

                <aside class="bp-spotify">
                    <header>
                        <span>MUSIC / SPOTIFY</span>
                        <a href="https://open.spotify.com/playlist/2noGfli9DsoQpf81dD5H7R" target="_blank" rel="noopener noreferrer">Open playlist ↗</a>
                    </header>
                    <iframe src="https://open.spotify.com/embed/playlist/2noGfli9DsoQpf81dD5H7R?utm_source=generator&theme=0" width="100%" height="352" style="border:0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy" title="Bima's Playlist on Spotify"></iframe>
                </aside>

            </div>
        </section>

    </main>
    <Footer />

    <script>
        // Filters
        document.querySelectorAll('.bp-filter').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.bp-filter').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                const f = btn.getAttribute('data-filter');
                document.querySelectorAll('.bp-card').forEach(c => {
                    (c as HTMLElement).style.display = (f === 'all' || c.getAttribute('data-category') === f) ? '' : 'none';
                });
            });
        });
    </script>
</BaseLayout>

<style>
.blog-section {
    padding: 56px 0 128px;
}

/* Filters */
.blog-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-bottom: 32px;
    border: 1px solid var(--line-strong);
    width: fit-content;
    max-width: 100%;
}

.bp-filter {
    height: 36px;
    padding: 0 16px;
    background: transparent;
    border: 0;
    color: var(--text-3);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast);
}

.bp-filter + .bp-filter {
    border-left: 1px solid var(--line-strong);
}

.bp-filter:hover {
    color: var(--text);
}

.bp-filter.active {
    background: var(--text);
    color: var(--bg);
}

/* Grid — hairline separated */
.bp-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
    margin-bottom: 48px;
}

.bp-card {
    position: relative;
    min-width: 0;
    background: var(--bg);
    transition: background-color var(--transition-base);
}

.bp-card.is-featured {
    background: var(--bg-raised);
    box-shadow: inset 0 1px 0 var(--accent);
}

.bp-card:hover {
    background: var(--surface);
}

.bp-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 300px;
    padding: 28px;
}

.bp-card-top {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 48px;
}

.bp-card-index {
    color: var(--text-4);
    font: 500 11px/1 var(--font-mono);
}

.bp-card-label {
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.bp-card-flag {
    padding: 3px 7px;
    border: 1px solid var(--accent-line);
    color: var(--accent);
    font: 500 9px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
}

.bp-card-date {
    margin-left: auto;
    color: var(--text-3);
    font: 400 10px/1 var(--font-mono);
    white-space: nowrap;
}

.bp-card-title {
    margin-bottom: 12px;
    color: var(--text);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
}

.bp-card-excerpt {
    max-width: 560px;
    color: var(--text-3);
    font-size: 14px;
    line-height: 1.7;
}

.bp-card-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 28px;
    color: var(--text-2);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color var(--transition-fast);
}

.bp-card-more span {
    display: inline-block;
    transition: transform var(--transition-base);
}

.bp-card-link:hover .bp-card-more {
    color: var(--accent);
}

.bp-card-link:hover .bp-card-more span {
    transform: translateX(4px);
}

.bp-playlist-note {
    max-width: 62ch;
    margin-top: 48px;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.6;
}

.bp-playlist-note a {
    color: var(--text);
    border-bottom: 1px solid var(--accent-line);
}

.bp-playlist-note a:hover {
    color: var(--accent);
}

/* Spotify */
.bp-spotify {
    margin-top: 16px;
    border: 1px solid var(--line-strong);
    background: var(--bg-raised);
}

.bp-spotify + .bp-spotify {
    margin-top: 16px;
}

.bp-spotify header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--line);
    color: var(--text-3);
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.12em;
}

.bp-spotify header a {
    color: var(--text-2);
    white-space: nowrap;
    transition: color var(--transition-fast);
}

.bp-spotify header a:hover {
    color: var(--accent);
}

.bp-spotify iframe {
    display: block;
}

@media (max-width: 1000px) {
    .bp-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 640px) {
    .bp-grid {
        grid-template-columns: 1fr;
    }

    .bp-card-link {
        min-height: 0;
        padding: 22px;
    }

    .bp-card-top {
        flex-wrap: wrap;
        margin-bottom: 28px;
    }
}
</style>
