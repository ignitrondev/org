---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import '../styles.css';

const base = import.meta.env.BASE_URL;

const schema = [
    {
        "@context": "https://schema.org",
        "@graph": [
            { "@type": "Blog", "@id": "https://ignitrondev.github.io/org/blog#blog", "name": "IgnitronDev Blog", "description": "Notes on clinical UI, healthcare engineering, and product development.", "url": "https://ignitrondev.github.io/org/blog/", "publisher": { "@id": "https://ignitrondev.github.io/org/#organization" }, "author": [{ "@id": "https://ignitrondev.github.io/org/#bima" }] },
            { "@type": "Person", "@id": "https://ignitrondev.github.io/org/#bima", "name": "Bima Adam Nugraha", "jobTitle": "Founder of IgnitronDev", "sameAs": ["https://instagram.com/xiaobima__"] }
        ]
    }
];

const allBlogPosts = await getCollection('blog');
const posts = allBlogPosts
    .map(post => ({
        ...post.data,
        slug: post.slug,
        dateFormatted: post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
    }))
    .sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<BaseLayout
    title="IgnitronDev Blog — Clinical UI, Healthcare Engineering & Product Notes"
    description="Notes from IgnitronDev about clinical UI, healthcare software engineering, product development, and the journey behind the work."
    keywords="IgnitronDev blog, clinical UI, healthcare software engineering, medical UI components, product development"
    schema={schema}
>
    <Navbar />
    <main class="main-content">

        <!-- Hero -->
        <section class="blog-page-hero">
            <div class="container">
                <span class="blog-page-badge">Blog</span>
                <h1 class="blog-page-title">Insights & Stories</h1>
                <p class="blog-page-subtitle">Technology, innovation, and the journey behind IgnitronDev.</p>
            </div>
        </section>

        <!-- Posts -->
        <section class="blog-page-content">
            <div class="container">

                <!-- Filters -->
                <div class="blog-page-filters" id="blogFilters">
                    <button class="bp-filter active" data-filter="all">All</button>
                    <button class="bp-filter" data-filter="story">Story</button>
                    <button class="bp-filter" data-filter="personal">Music</button>
                    <button class="bp-filter" data-filter="technology">Tech</button>
                    <button class="bp-filter" data-filter="innovation">Innovation</button>
                    <button class="bp-filter" data-filter="company">Company</button>
                </div>

                <!-- Grid -->
                <div class="bp-grid" id="blogGrid">
                    {posts.map(post => (
                        <article class={`bp-card${post.featured ? ' bp-card-featured' : ''}`} data-category={post.category}>
                            <a href={`${base}blog/${post.slug}`} style="text-decoration: none; color: inherit; display: block; height: 100%;">
                                <div class="bp-card-top" style={`border-color: ${post.color};`}>
                                    <span class="bp-card-label" style={`color: ${post.color};`}>{post.label}</span>
                                    <time class="bp-card-date">{post.dateFormatted}</time>
                                </div>
                                <h2 class="bp-card-title">{post.title}</h2>
                                <p class="bp-card-excerpt">{post.excerpt}</p>
                                {post.featured && <span class="bp-card-badge">Featured</span>}
                            </a>
                        </article>
                    ))}
                </div>

                <!-- Spotify -->
                <div class="bp-spotify">
                    <div class="bp-spotify-header">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="color: #1DB954;"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
                        <h3>Bima's Playlist</h3>
                    </div>
                    <iframe style="border-radius:12px" src="https://open.spotify.com/embed/playlist/2noGfli9DsoQpf81dD5H7R?utm_source=generator&theme=0" width="100%" height="352" frameborder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
                </div>

                <!-- Newsletter -->
                <div class="bp-newsletter">
                    <h3>Stay Updated</h3>
                    <p>Get the latest posts delivered to your inbox.</p>
                    <form class="bp-newsletter-form" id="newsletterForm">
                        <input type="email" placeholder="your@email.com" required />
                        <button type="submit" class="btn btn-primary">Subscribe</button>
                    </form>
                </div>

            </div>
        </section>

    </main>
    <Footer />

    <script>
        // Filters
        document.querySelectorAll('.bp-filter').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.bp-filter').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                const f = this.getAttribute('data-filter');
                document.querySelectorAll('.bp-card').forEach(c => {
                    (c as HTMLElement).style.display = (f === 'all' || c.getAttribute('data-category') === f) ? '' : 'none';
                });
            });
        });
        // Newsletter
        document.getElementById('newsletterForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            const btn = (this as HTMLFormElement).querySelector('button') as HTMLButtonElement;
            btn.textContent = '✓ Subscribed';
            btn.disabled = true;
            setTimeout(() => { btn.textContent = 'Subscribe'; btn.disabled = false; (this as HTMLFormElement).reset(); }, 3000);
        });
    </script>
</BaseLayout>

<style>
/* Blog Page — Clean Professional Layout */
.blog-page-hero {
    padding: 140px 24px 60px;
    text-align: center;
}

.blog-page-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--cyber-cyan);
    margin-bottom: 16px;
}

.blog-page-title {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
}

.blog-page-subtitle {
    font-size: 18px;
    color: var(--steel-silver);
    max-width: 500px;
    margin: 0 auto;
}

.blog-page-content {
    padding: 0 24px 80px;
}

/* Filters */
.blog-page-filters {
    display: flex;
    gap: 8px;
    margin-bottom: 40px;
    flex-wrap: wrap;
}

.bp-filter {
    padding: 8px 16px;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--steel-silver);
    font-size: 13px;
    font-weight: 500;
    font-family: var(--font-family);
    cursor: pointer;
    transition: all 0.15s ease;
}

.bp-filter:hover {
    border-color: var(--cyber-cyan);
    color: var(--white);
}

.bp-filter.active {
    background: var(--cyber-cyan);
    border-color: var(--cyber-cyan);
    color: var(--black);
    font-weight: 600;
}

/* Grid */
.bp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 60px;
}

/* Card */
.bp-card {
    background: var(--black);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 24px;
    transition: border-color 0.2s, transform 0.2s;
    position: relative;
}

.bp-card:hover {
    border-color: var(--cyber-cyan-dark);
    transform: translateY(-2px);
}

.bp-card-featured {
    grid-column: 1 / -1;
    background: var(--deep-space-light);
    border-color: var(--border-color);
}

.bp-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
}

.bp-card-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.bp-card-date {
    font-size: 12px;
    color: var(--steel-silver);
    font-family: var(--mono-font);
}

.bp-card-title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 8px;
    color: var(--white);
}

.bp-card-excerpt {
    font-size: 14px;
    color: var(--steel-silver);
    line-height: 1.6;
}

.bp-card-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 3px 8px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--cyber-cyan-dark);
    border-radius: 4px;
}

/* Spotify */
.bp-spotify {
    margin-bottom: 60px;
    padding: 24px;
    background: var(--black);
    border: 1px solid var(--border-color);
    border-radius: 8px;
}

.bp-spotify-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
}

.bp-spotify-header h3 {
    font-size: 16px;
    font-weight: 600;
}

.bp-spotify iframe {
    border-radius: 8px;
    display: block;
}

/* Newsletter */
.bp-newsletter {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
    padding: 40px 24px;
    background: var(--black);
    border: 1px solid var(--border-color);
    border-radius: 8px;
}

.bp-newsletter h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 8px;
}

.bp-newsletter p {
    font-size: 14px;
    color: var(--steel-silver);
    margin-bottom: 20px;
}

.bp-newsletter-form {
    display: flex;
    gap: 8px;
}

.bp-newsletter-form input {
    flex: 1;
    padding: 10px 14px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--white);
    font-family: var(--font-family);
    font-size: 14px;
}

.bp-newsletter-form input::placeholder {
    color: var(--steel-silver);
}

.bp-newsletter-form input:focus {
    outline: none;
    border-color: var(--cyber-cyan);
}

@media (max-width: 768px) {
    .bp-grid {
        grid-template-columns: 1fr;
    }

    .bp-card-featured {
        grid-column: 1;
    }

    .bp-newsletter-form {
        flex-direction: column;
    }
}
</style>
