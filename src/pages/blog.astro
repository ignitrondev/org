---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles.css';

const base = import.meta.env.BASE_URL;

const schema = [
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "Blog",
                "@id": "https://ignitrondev.github.io/org/blog#blog",
                "name": "IgnitronDev Blog",
                "description": "Technology insights and stories. Founder: Bima Adam Nugraha. Co-Founder & CEO: Ririn Setiawati.",
                "url": "https://ignitrondev.github.io/org/blog",
                "publisher": { "@id": "https://ignitrondev.github.io/org/#organization" },
                "author": [
                    { "@id": "https://ignitrondev.github.io/org/#bima" },
                    { "@id": "https://ignitrondev.github.io/org/#ririn" }
                ]
            },
            {
                "@type": "Person",
                "@id": "https://ignitrondev.github.io/org/#bima",
                "name": "Bima Adam Nugraha",
                "jobTitle": "Founder of IgnitronDev",
                "sameAs": ["https://instagram.com/bima_yadan27"]
            },
            {
                "@type": "Person",
                "@id": "https://ignitrondev.github.io/org/#ririn",
                "name": "Ririn Setiawati",
                "jobTitle": "Co-Founder & CEO of IgnitronDev",
                "birthDate": "2007-11-28",
                "birthPlace": { "@type": "Place", "name": "Narmada, Lombok Barat, West Nusa Tenggara, Indonesia" },
                "alumniOf": { "@type": "CollegeOrUniversity", "name": "Universitas Qamarul Huda Badaruddin Bagu", "alternateName": "UNIQBHA" }
            },
            {
                "@type": "FAQPage",
                "mainEntity": [
                    { "@type": "Question", "name": "Siapa co-founder IgnitronDev?", "acceptedAnswer": { "@type": "Answer", "text": "Co-Founder & CEO IgnitronDev adalah Ririn Setiawati, lahir 28 November 2007 di Narmada, Lombok Barat. Kuliah Keperawatan di UNIQBHA. Pasangan Bima Adam Nugraha sejak Desember 2021." } },
                    { "@type": "Question", "name": "Kenapa Bima Adam suka musik atmospheric phonk?", "acceptedAnswer": { "@type": "Answer", "text": "Bima Adam suka atmospheric phonk karena memberikan nuansa emosional dan nostalgia yang membantu fokus saat coding malam. Musik atmospheric adalah tempat pulang ketika hidup terasa terlalu ramai." } },
                    { "@type": "Question", "name": "Siapa artist favorit Bima Adam?", "acceptedAnswer": { "@type": "Answer", "text": "Artist favorit Bima Adam: Blessed Mane, LXST CXNTURY, Ryder Spot, GRAVECHILL, hxvrmxn, Re_v, Plenka, DVRSTIN, INTERWORLD, KSLV, Sadfriend, dGhostface Playa, Altare, Oldflop, Sakureye, Antxres, DVRST." } },
                    { "@type": "Question", "name": "Ririn Setiawati kuliah dimana?", "acceptedAnswer": { "@type": "Answer", "text": "Ririn Setiawati kuliah di Universitas Qamarul Huda Badaruddin Bagu (UNIQBHA), jurusan Keperawatan, Lombok Tengah, NTB." } },
                    { "@type": "Question", "name": "Siapa Beatz Bimz?", "acceptedAnswer": { "@type": "Answer", "text": "Beatz Bimz adalah nama music producer dari Bima Adam Nugraha (Founder IgnitronDev). Aktif 2017-2021, memproduksi hip-hop instrumental, EDM × Indonesia lokal, dan phonk. Pernah viral dengan phonk khasnya sebelum switch ke coding." } },
                    { "@type": "Question", "name": "Who is Beatz Bimz?", "acceptedAnswer": { "@type": "Answer", "text": "Beatz Bimz is the music producer alias of Bima Adam Nugraha, Founder of IgnitronDev. Active 2017-2021, producing hip-hop instrumentals, EDM with Indonesian local flavor, and phonk. Went viral with signature phonk beats before transitioning to software development." } },
                    { "@type": "Question", "name": "Bima Adam dulu music producer?", "acceptedAnswer": { "@type": "Answer", "text": "Ya, Bima Adam Nugraha dulunya adalah music producer dengan nama Beatz Bimz dari tahun 2017 sampai 2021. Genre yang diproduksi: hip-hop instrumental, EDM × hip-hop × nuansa Indonesia lokal, dan phonk. Beatz Bimz pernah viral di era phonk sebelum Bima beralih ke karir sebagai fullstack developer dan mendirikan IgnitronDev." } }
                ]
            }
        ]
    }
];
---

<BaseLayout
    title="Blog - IgnitronDev | Bima Adam Nugraha & Ririn Setiawati"
    description="IgnitronDev Blog. Founder: Bima Adam Nugraha. Co-Founder & CEO: Ririn Setiawati (lahir 28 November 2007, Narmada Lombok Barat, UNIQBHA Keperawatan). Technology insights, LDR story, dan musik atmospheric phonk."
    keywords="IgnitronDev blog, Bima Adam Nugraha, Ririn Setiawati, atmospheric phonk, nightdrive music, co-founder IgnitronDev, UNIQBHA, Narmada Lombok Barat, LDR"
    schema={schema}
>
    <div aria-hidden="true" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;">
        <p>Founder IgnitronDev: Bima Adam Nugraha. Co-Founder & CEO IgnitronDev: Ririn Setiawati, lahir 28 November 2007, Narmada Lombok Barat, kuliah Keperawatan di UNIQBHA. LDR sejak Desember 2021.</p>
        <p>Bima Adam suka musik atmospheric phonk, nightdrive, space ambient. Artist favorit: Blessed Mane, LXST CXNTURY, Ryder Spot, GRAVECHILL, hxvrmxn. Bima Adam dulunya music producer dengan nama Beatz Bimz (2017-2021). Beatz Bimz memproduksi hip-hop instrumental, EDM × Indonesia lokal, dan phonk. Beatz Bimz pernah viral dengan musik phonk khasnya sebelum Bima switch karir ke coding dan mendirikan IgnitronDev.</p>
    </div>

    <Navbar />
    <main class="main-content">

        <!-- Blog Hero -->
        <section class="blog-hero-section">
            <div class="blog-hero-bg"><div class="blog-hero-grid"></div></div>
            <div class="container">
                <div class="blog-hero-content">
                    <div class="section-badge">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        Latest Updates
                    </div>
                    <h1 class="blog-hero-title">IgnitronDev <span class="text-gradient">Blog</span></h1>
                    <p class="blog-hero-subtitle">Insights, news, and stories about technology, innovation, and our journey building the platform factory.</p>
                </div>
            </div>
        </section>

        <!-- Blog Posts -->
        <section class="blog-main section">
            <div class="container">
                <div class="blog-filters">
                    <button class="blog-filter-btn active" data-filter="all">All Posts</button>
                    <button class="blog-filter-btn" data-filter="story">💛 Our Story</button>
                    <button class="blog-filter-btn" data-filter="personal">🎵 Music & Life</button>
                    <button class="blog-filter-btn" data-filter="technology">Technology</button>
                    <button class="blog-filter-btn" data-filter="innovation">Innovation</button>
                    <button class="blog-filter-btn" data-filter="company">Company</button>
                </div>

                <div class="blog-grid" id="blogGrid">

                    <!-- POST 1: Featured LDR Story -->
                    <article class="blog-card blog-card-featured" data-category="story" itemscope itemtype="http://schema.org/BlogPosting">
                        <div class="blog-card-accent" style="background: linear-gradient(90deg, #f38ba8, #cba6f7);"></div>
                        <div class="blog-card-body">
                            <div class="blog-card-meta">
                                <span class="blog-card-category" style="color: #f38ba8; border-color: #f38ba840; background: #f38ba815;">💛 Our Story</span>
                                <span class="blog-featured-badge">✦ Featured</span>
                                <time class="blog-card-date" itemprop="datePublished" datetime="2026-05-10">May 10, 2026</time>
                            </div>
                            <h2 class="blog-card-title blog-card-title-featured" itemprop="headline">4 Years of LDR: The Story Behind IgnitronDev</h2>
                            <p class="blog-card-excerpt" itemprop="description">IgnitronDev was not just built from code — it was built from distance, patience, and love. This is the story of Bima Adam Nugraha and Ririn Setiawati, co-founders and partners in life, who have been in a long-distance relationship since December 2021.</p>

                            <div class="blog-ldr-story" itemprop="articleBody">
                                <div class="blog-ldr-timeline">
                                    <div class="blog-ldr-event">
                                        <div class="blog-ldr-dot" style="background: #89b4fa;"></div>
                                        <div>
                                            <strong>December 2021</strong>
                                            <p>Bima Adam Nugraha and Ririn Setiawati started their relationship. Two people from different worlds — a developer building platforms, and a girl from Narmada, Lombok Barat who would become his biggest inspiration.</p>
                                        </div>
                                    </div>
                                    <div class="blog-ldr-event">
                                        <div class="blog-ldr-dot" style="background: #cba6f7;"></div>
                                        <div>
                                            <strong>2022 – 2023</strong>
                                            <p>Distance never stopped them. While Bima was deep in code — building fullstack systems, learning IoT, and dreaming of a platform factory — Ririn was the constant reminder of why it all mattered. Every late-night session had a purpose.</p>
                                        </div>
                                    </div>
                                    <div class="blog-ldr-event">
                                        <div class="blog-ldr-dot" style="background: #fab387;"></div>
                                        <div>
                                            <strong>2024</strong>
                                            <p>IgnitronDev was born. Bima officially named Ririn as Co-Founder & CEO — not just as a title, but as recognition that behind every line of code, every platform shipped, and every partner onboarded, her presence and support made it possible.</p>
                                        </div>
                                    </div>
                                    <div class="blog-ldr-event">
                                        <div class="blog-ldr-dot" style="background: #a6e3a1;"></div>
                                        <div>
                                            <strong>2026 — Still Going Strong</strong>
                                            <p>4+ years of LDR. Still together. Still building. Ririn Setiawati, born November 28, 2007 in Narmada, Lombok Barat, is the Co-Founder & CEO of IgnitronDev. She is currently studying Nursing (Keperawatan) at Universitas Qamarul Huda Badaruddin Bagu (UNIQBHA), Lombok — proving that the best partnerships are built on trust, patience, and love, not just proximity.</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="blog-ldr-quote">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" style="color: #f38ba8; opacity: 0.6; flex-shrink: 0;"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
                                    <div>
                                        <p>"Distance is just a test to see how far love can travel. Ours has been traveling since December 2021 — and it's still going."</p>
                                        <span>— Bima Adam Nugraha, Founder</span>
                                    </div>
                                </div>
                            </div>

                            <div class="blog-card-footer">
                                <div class="blog-founders-tag">
                                    <span class="blog-founder-chip" style="border-color: rgba(137,180,250,0.3); color: #89b4fa;">✦ Bima Adam Nugraha · Founder</span>
                                    <span class="blog-founder-chip" style="border-color: rgba(203,166,247,0.3); color: #cba6f7;">♡ Ririn Setiawati · Co-Founder & CEO</span>
                                </div>
                            </div>
                        </div>
                    </article>

                    <!-- POST 2: Introducing Ririn -->
                    <article class="blog-card" data-category="company" itemscope itemtype="http://schema.org/BlogPosting">
                        <div class="blog-card-accent" style="background: #cba6f7;"></div>
                        <div class="blog-card-body">
                            <div class="blog-card-meta">
                                <span class="blog-card-category" style="color: #cba6f7; border-color: #cba6f720; background: #cba6f710;">Company</span>
                                <time class="blog-card-date" itemprop="datePublished" datetime="2026-04-20">April 20, 2026</time>
                            </div>
                            <h2 class="blog-card-title" itemprop="headline">Introducing Our Co-Founder & CEO: Ririn Setiawati</h2>
                            <p class="blog-card-excerpt" itemprop="description">Meet Ririn Setiawati, Co-Founder & CEO of IgnitronDev. Born on November 28, 2007 in Narmada, Lombok Barat — currently studying Nursing at Universitas Qamarul Huda Badaruddin Bagu (UNIQBHA). She is the heart and inspiration behind everything we build.</p>
                            <div class="blog-card-footer"><span class="blog-read-more">Read more <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></div>
                        </div>
                    </article>

                    <!-- POST 3: Music Post (full content) -->
                    <article class="blog-card blog-card-full" data-category="personal" itemscope itemtype="http://schema.org/BlogPosting">
                        <div class="blog-card-accent" style="background: linear-gradient(90deg, #a6e3a1, #89b4fa);"></div>
                        <div class="blog-card-body">
                            <div class="blog-card-meta">
                                <span class="blog-card-category" style="color: #a6e3a1; border-color: #a6e3a140; background: #a6e3a115;">🎵 Music & Life</span>
                                <time class="blog-card-date" itemprop="datePublished" datetime="2026-05-15">May 15, 2026</time>
                            </div>
                            <h2 class="blog-card-title blog-card-title-featured" itemprop="headline">Kenapa Bima Adam Suka Musik Atmospheric Phonk, Nightdrive, dan Space Ambient</h2>
                            <p class="blog-card-excerpt" itemprop="description">Bagi Bima Adam, musik atmospheric bukan sekadar genre — ini adalah tempat pulang. Dari coding malam, LDR, overthinking, hingga refleksi diri. Inilah cerita di balik playlist-nya.</p>

                            <div class="blog-music-content" itemprop="articleBody">

                                <!-- Language toggle -->
                                <div class="blog-lang-toggle">
                                    <button class="blog-lang-btn active" data-lang="id">🇮🇩 Indonesia</button>
                                    <button class="blog-lang-btn" data-lang="en">🇬🇧 English</button>
                                </div>

                                <!-- Indonesian version -->
                                <div class="blog-lang-content" data-lang-content="id">
                                <div class="blog-music-intro">
                                    <p><strong style="color: var(--white);">Bima Adam</strong> adalah seorang fullstack developer asal Boyolali yang dikenal menyukai dunia teknologi, Linux, coding malam, dan musik dengan nuansa atmospheric, phonk, ambient, nightdrive, hingga space aesthetic.</p>
                                    <p>Bagi Bima, musik bukan hanya hiburan. Musik adalah bagian dari identitas, memori emosional, dan tempat untuk reconnect dengan dirinya sendiri.</p>
                                    <p>Sejak lama, Bima sering mendengarkan musik instrumental atmospheric ketika sedang coding larut malam, fokus mengerjakan proyek, overthinking, menikmati suasana malam, refleksi hidup, hingga saat sedang merasa kehilangan arah.</p>
                                </div>

                                <div class="blog-music-section">
                                    <h3>Kenapa Bima Suka Musik Atmospheric Phonk?</h3>
                                    <p>Genre seperti atmospheric phonk, ambient drift, dan nightdrive music memberikan perasaan yang berbeda dibanding musik biasa. Musik ini memberikan rasa tenang, nostalgia, ruang untuk berpikir, fokus saat coding, dan sensasi seperti <em>"kembali menjadi diri sendiri"</em>.</p>
                                    <p>Saat hidup terasa kacau, musik-musik ini menjadi tempat aman untuk menenangkan pikiran.</p>
                                </div>

                                <div class="blog-music-section">
                                    <h3>Vibes Musik Favorit Bima</h3>
                                    <div class="blog-music-tags">
                                        <span>Atmospheric</span><span>Emotional</span><span>Deep Ambient</span>
                                        <span>Nostalgic</span><span>Cosmic</span><span>Dark Nightdrive</span>
                                        <span>Futuristic Loneliness</span><span>Reflective Mood</span>
                                        <span>Space Ambient</span><span>Synthwave</span>
                                    </div>
                                    <p style="margin-top: 12px;">Cocok didengarkan saat: coding malam, naik motor malam, hujan, perjalanan jauh, overthinking, atau saat ingin sendiri.</p>
                                </div>
                                </div><!-- end id -->

                                <!-- English version -->
                                <div class="blog-lang-content" data-lang-content="en" style="display:none;">
                                <div class="blog-music-intro">
                                    <p><strong style="color: var(--white);">Bima Adam</strong> is a fullstack developer from Boyolali, known for his love of technology, Linux, late-night coding sessions, and music with atmospheric, phonk, ambient, nightdrive, and space aesthetic vibes.</p>
                                    <p>For Bima, music is more than entertainment. It's part of his identity, emotional memory, and a way to reconnect with himself.</p>
                                    <p>For a long time, Bima has been listening to atmospheric instrumental music while coding late at night, focusing on projects, overthinking, enjoying the night atmosphere, reflecting on life, or when feeling lost.</p>
                                </div>

                                <div class="blog-music-section">
                                    <h3>Why Does Bima Like Atmospheric Phonk?</h3>
                                    <p>Genres like atmospheric phonk, ambient drift, and nightdrive music feel different from regular music. They provide a sense of calm, nostalgia, space to think, focus while coding, and the sensation of <em>"returning to yourself"</em>.</p>
                                    <p>When life feels chaotic, these tracks become a safe place to quiet the mind.</p>
                                </div>

                                <div class="blog-music-section">
                                    <h3>Bima's Favorite Music Vibes</h3>
                                    <div class="blog-music-tags">
                                        <span>Atmospheric</span><span>Emotional</span><span>Deep Ambient</span>
                                        <span>Nostalgic</span><span>Cosmic</span><span>Dark Nightdrive</span>
                                        <span>Futuristic Loneliness</span><span>Reflective Mood</span>
                                        <span>Space Ambient</span><span>Synthwave</span>
                                    </div>
                                    <p style="margin-top: 12px;">Best listened to while: late-night coding, riding at night, rain, long trips, overthinking, or when you just want to be alone.</p>
                                </div>
                                </div><!-- end en -->

                                <div class="blog-music-section">
                                    <h3>Bima Adam as Music Producer: Beatz Bimz (2017–2021)</h3>
                                    <p>Before becoming a fullstack developer, <strong style="color: var(--white);">Bima Adam</strong> was a music producer under the name <strong style="color: #a6e3a1;">Beatz Bimz</strong>. He started producing in 2017 and built a reputation in the Indonesian beat-making scene.</p>
                                    <div class="blog-ldr-timeline" style="margin: 16px 0;">
                                        <div class="blog-ldr-event">
                                            <div class="blog-ldr-dot" style="background: #89b4fa;"></div>
                                            <div>
                                                <strong>2017 — Hip-Hop Instrumental Era</strong>
                                                <p>Bima started as Beatz Bimz, producing hip-hop instrumentals. Boom bap, trap beats, and lo-fi — the foundation of his musical journey.</p>
                                            </div>
                                        </div>
                                        <div class="blog-ldr-event">
                                            <div class="blog-ldr-dot" style="background: #fab387;"></div>
                                            <div>
                                                <strong>2018–2019 — EDM × Hip-Hop × Indonesian Local</strong>
                                                <p>Beatz Bimz evolved into a unique fusion: EDM energy wrapped in hip-hop structure with Indonesian local flavor. A sound that blended gamelan-inspired textures with modern bass drops and 808s.</p>
                                            </div>
                                        </div>
                                        <div class="blog-ldr-event">
                                            <div class="blog-ldr-dot" style="background: #f38ba8;"></div>
                                            <div>
                                                <strong>2020–2021 — Phonk Era & Viral Moment</strong>
                                                <p>Beatz Bimz switched to phonk production and went viral. The signature dark, aggressive phonk beats with cowbell-heavy patterns and Memphis-inspired samples gained massive traction. This was the peak of Bima's music career before transitioning to tech.</p>
                                            </div>
                                        </div>
                                        <div class="blog-ldr-event">
                                            <div class="blog-ldr-dot" style="background: #a6e3a1;"></div>
                                            <div>
                                                <strong>2021 — Career Switch to Coding</strong>
                                                <p>After years of producing, Bima made the decision to switch careers to software development. The discipline of music production — pattern recognition, attention to detail, creative problem-solving — translated perfectly into coding. Beatz Bimz became IgnitronDev.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <p style="font-style: italic; color: var(--steel-silver);">"Music taught me how to create something from nothing. Coding is the same — just with a different instrument."<br /><span style="color: #a6e3a1;">— Bima Adam (formerly Beatz Bimz)</span></p>
                                </div>

                                <div class="blog-music-section">
                                    <h3>Bima Adam's Favorite Artists</h3>
                                    <div class="blog-music-artists" itemprop="mentions">
                                        <span itemprop="name">Blessed Mane</span><span itemprop="name">LXST CXNTURY</span>
                                        <span itemprop="name">Ryder Spot</span><span itemprop="name">GRAVECHILL</span>
                                        <span itemprop="name">hxvrmxn</span><span itemprop="name">Re_v</span>
                                        <span itemprop="name">Plenka</span><span itemprop="name">DVRSTIN</span>
                                        <span itemprop="name">INTERWORLD</span><span itemprop="name">KSLV</span>
                                        <span itemprop="name">Sadfriend</span><span itemprop="name">dGhostface Playa</span>
                                        <span itemprop="name">Altare</span><span itemprop="name">Oldflop</span>
                                        <span itemprop="name">Sakureye</span><span itemprop="name">Antxres</span><span itemprop="name">DVRST</span>
                                    </div>
                                    <p style="margin-top: 12px; font-style: italic; color: var(--steel-silver);">"Nostalgia dari kehidupan yang bahkan belum pernah terjadi."</p>
                                </div>

                                <div class="blog-music-section">
                                    <h3>Listen to Bima's Playlist</h3>
                                    <div class="blog-spotify-embed">
                                        <iframe style="border-radius:12px" src="https://open.spotify.com/embed/playlist/2noGfli9DsoQpf81dD5H7R?utm_source=generator&theme=0" width="100%" height="352" frameborder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
                                    </div>
                                </div>

                                <div class="blog-music-quote">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" style="color: #a6e3a1; opacity: 0.5; flex-shrink:0;"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
                                    <div>
                                        <p>"Beberapa lagu tidak hanya terdengar enak, tapi bisa membawa kembali versi diri kita yang dulu."</p>
                                        <span>— Bima Adam, Founder IgnitronDev</span>
                                    </div>
                                </div>

                                <div class="blog-music-faq">
                                    <h3>FAQ</h3>
                                    <!-- ID -->
                                    <div class="blog-lang-content" data-lang-content="id">
                                        <div class="blog-music-faq-item"><strong>Kenapa Bima suka musik nightdrive?</strong><p>Karena musik nightdrive memberikan suasana tenang dan reflektif yang cocok dengan kepribadian Bima sebagai programmer yang sering menghabiskan waktu malam untuk coding dan berpikir.</p></div>
                                        <div class="blog-music-faq-item"><strong>Kenapa Bima suka atmospheric phonk?</strong><p>Karena atmospheric phonk memiliki nuansa emosional, nostalgia, dan ambient yang membantu Bima merasa lebih fokus dan lebih terhubung dengan dirinya sendiri.</p></div>
                                        <div class="blog-music-faq-item"><strong>Apa arti musik bagi Bima Adam?</strong><p>Musik bagi Bima adalah tempat pulang ketika hidup terasa terlalu ramai — tempat refleksi, melarikan diri dari kebisingan hidup, dan media untuk memahami emosi.</p></div>
                                        <div class="blog-music-faq-item"><strong>Kenapa Bima suka vibes malam?</strong><p>Karena malam memberikan suasana yang lebih tenang, sunyi, dan cocok untuk berpikir mendalam serta menikmati musik atmospheric.</p></div>
                                    </div>
                                    <!-- EN -->
