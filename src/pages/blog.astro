    <script>
        // Language toggle
        document.querySelectorAll('.blog-lang-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const lang = this.getAttribute('data-lang');
                // Update buttons
                document.querySelectorAll('.blog-lang-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                // Show/hide content
                document.querySelectorAll('.blog-lang-content').forEach(el => {
                    (el as HTMLElement).style.display = el.getAttribute('data-lang-content') === lang ? 'block' : 'none';
                });
            });
        });

        // Filter
        document.querySelectorAll('.blog-filter-btn').forEach(btn => {
            btn.addEventListener('click', function(this: HTMLElement) {
                document.querySelectorAll('.blog-filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                const filter = this.getAttribute('data-filter');
                let visible = 0;
                document.querySelectorAll('.blog-card').forEach(card => {
                    const show = filter === 'all' || card.getAttribute('data-category') === filter;
                    (card as HTMLElement).style.display = show ? 'flex' : 'none';
                    if (show) visible++;
                });
                const empty = document.getElementById('blogEmpty');
                if (empty) empty.style.display = visible === 0 ? 'flex' : 'none';
            });
        });

        document.getElementById('newsletterForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            const btn = (this as HTMLFormElement).querySelector('button') as HTMLButtonElement;
            btn.textContent = 'Subscribed!';
            btn.disabled = true;
            setTimeout(() => { btn.textContent = 'Subscribe'; btn.disabled = false; (this as HTMLFormElement).reset(); }, 3000);
        });
    </script>
