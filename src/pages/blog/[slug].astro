---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles.css';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const base = import.meta.env.BASE_URL;
const { data } = entry;
const dateFormatted = data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const wordCount = entry.body.split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 220));

const site = 'https://ignitrondev.space';
const postURL = new URL(`${base}blog/${entry.slug}/`, Astro.site).href;
const ogImage = data.ogImage ?? 'images/ignitron.png';
const ogImageURL = new URL(`${base}${ogImage.replace(/^\//, '')}`, Astro.site).href;
const pageTitle = data.seoTitle ?? `${data.title} - IgnitronDev Blog`;
const pageDescription = data.seoDescription ?? data.excerpt;
const playlistURL = data.spotifyPlaylist ? `https://open.spotify.com/playlist/${data.spotifyPlaylist}` : undefined;

const schema = [
    {
        '@context': 'https://schema.org',
        '@graph': [
            {
                '@type': 'BlogPosting',
                '@id': `${postURL}#article`,
                headline: data.title,
                description: pageDescription,
                url: postURL,
                mainEntityOfPage: postURL,
                image: ogImageURL,
                datePublished: data.date.toISOString(),
                dateModified: (data.updated ?? data.date).toISOString(),
                inLanguage: 'en',
                wordCount,
                articleSection: data.label,
                ...(data.keywords && { keywords: data.keywords.join(', ') }),
                author: { '@id': `${site}/#bima` },
                publisher: { '@id': `${site}/#organization` },
                isPartOf: { '@id': `${site}/blog#blog` },
                ...(playlistURL && { associatedMedia: { '@id': `${postURL}#playlist` } }),
            },
            {
                '@type': 'Person',
                '@id': `${site}/#bima`,
                name: 'Bima Adam Nugraha',
                alternateName: 'Beatz Bimz',
                jobTitle: 'Founder & CEO of IgnitronDev',
                url: `${site}/`,
                sameAs: ['https://instagram.com/xiaobima__'],
            },
            {
                '@type': 'Organization',
                '@id': `${site}/#organization`,
                name: 'IgnitronDev',
                url: `${site}/`,
                logo: `${site}/images/ignitron.png`,
            },
            ...(playlistURL
                ? [{
                    '@type': 'MusicPlaylist',
                    '@id': `${postURL}#playlist`,
                    name: data.spotifyPlaylistName ?? `${data.title} — playlist`,
                    url: playlistURL,
                    creator: { '@id': `${site}/#bima` },
                }]
                : []),
            {
                '@type': 'BreadcrumbList',
                itemListElement: [
                    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
                    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog/` },
                    { '@type': 'ListItem', position: 3, name: data.title, item: postURL },
                ],
            },
        ],
    },
];
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    keywords={data.keywords?.join(', ')}
    canonical={postURL}
    ogType="article"
    ogImage={ogImage}
    ogImageAlt={data.title}
    schema={schema}
>
    <Fragment slot="head">
        <meta property="article:published_time" content={data.date.toISOString()} />
        <meta property="article:modified_time" content={(data.updated ?? data.date).toISOString()} />
        <meta property="article:author" content="Bima Adam Nugraha" />
        <meta property="article:section" content={data.label} />
        {data.keywords?.map((tag) => <meta property="article:tag" content={tag} />)}
    </Fragment>
    <Navbar />
    <main class="main-content">
        <section class="page-hero post-hero">
            <div class="container post-measure">
                <a href={`${base}blog/`} class="post-back"><span aria-hidden="true">←</span> All posts</a>
                <span class="post-label" style={`color: ${entry.data.color};`}>{entry.data.label}</span>
                <h1>{entry.data.title}</h1>
                <p>{entry.data.excerpt}</p>
                <dl class="post-meta">
                    <div><dt>Published</dt><dd><time datetime={entry.data.date.toISOString()}>{dateFormatted}</time></dd></div>
                    <div><dt>Author</dt><dd>Bima Adam Nugraha</dd></div>
                    <div><dt>Reading</dt><dd>{readingMinutes} min</dd></div>
                </dl>
            </div>
        </section>

        <section class="post-body">
            <div class="container post-measure">
                <div class="prose">
                    <Content />
                </div>
                {playlistURL && (
                    <aside class="post-playlist" aria-label="Spotify playlist">
                        <header>
                            <span>LISTEN / {data.spotifyPlaylistName ?? 'PLAYLIST'}</span>
                            <a href={playlistURL} target="_blank" rel="noopener noreferrer">Open in Spotify ↗</a>
                        </header>
                        <iframe
                            src={`https://open.spotify.com/embed/playlist/${data.spotifyPlaylist}?utm_source=generator&theme=0`}
                            width="100%"
                            height="352"
                            frameborder="0"
                            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                            loading="lazy"
                            title={`${data.spotifyPlaylistName ?? 'Playlist'} by Bima Adam Nugraha on Spotify`}
                        ></iframe>
                    </aside>
                )}
                {data.keywords && (
                    <ul class="post-tags" aria-label="Topics">
                        {data.keywords.map((tag) => <li>{tag}</li>)}
                    </ul>
                )}
                <a href={`${base}blog/`} class="post-back post-back-end"><span aria-hidden="true">←</span> Back to all posts</a>
            </div>
        </section>
    </main>
    <Footer />
</BaseLayout>

<style>
.post-measure {
    max-width: calc(760px + var(--gutter) * 2);
}

.post-hero {
    padding-bottom: 64px;
}

.post-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-3);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color var(--transition-fast);
}

.post-back:hover {
    color: var(--text);
}

.post-label {
    display: block;
    margin-top: 48px;
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
}

.post-hero h1 {
    margin: 22px 0 20px;
    font-size: clamp(36px, 5.4vw, 60px);
    line-height: 1.02;
    letter-spacing: -0.045em;
}

.post-meta {
    display: flex;
    flex-wrap: wrap;
    margin-top: 40px;
    border-top: 1px solid var(--line);
}

.post-meta div {
    padding: 16px 32px 0 0;
}

.post-meta dt {
    color: var(--text-4);
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.post-meta dd {
    margin-top: 8px;
    color: var(--text-2);
    font-size: 14px;
}

.post-body {
    padding: 64px 0 112px;
    border-bottom: 1px solid var(--line);
}

.post-playlist {
    margin-top: 48px;
    border: 1px solid var(--line-strong);
    background: var(--bg-raised);
}

.post-playlist header {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    color: var(--text-3);
    font: 500 10px/1.4 var(--font-mono);
    letter-spacing: 0.12em;
}

.post-playlist header a {
    color: var(--text-2);
    white-space: nowrap;
    transition: color var(--transition-fast);
}

.post-playlist header a:hover {
    color: var(--accent);
}

.post-playlist iframe {
    display: block;
}

.post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 32px;
}

.post-tags li {
    padding: 5px 9px;
    border: 1px solid var(--line-strong);
    color: var(--text-3);
    font: 500 10px/1.2 var(--font-mono);
    letter-spacing: 0.04em;
}

.post-back-end {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    width: 100%;
}

/* Markdown content */
.prose {
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.8;
}

.prose > :global(:first-child) {
    margin-top: 0;
}

/* The page header already shows the title */
.prose > :global(h1:first-child) {
    display: none;
}

.prose :global(h1),
.prose :global(h2),
.prose :global(h3),
.prose :global(h4) {
    color: var(--text);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
}

.prose :global(h2) {
    margin: 2.4em 0 0.8em;
    padding-top: 1.2em;
    border-top: 1px solid var(--line);
    font-size: 26px;
}

.prose :global(h3) {
    margin: 2em 0 0.6em;
    font-size: 20px;
}

.prose :global(p) {
    margin-bottom: 1.4em;
}

.prose :global(a) {
    color: var(--text);
    border-bottom: 1px solid var(--accent-line);
    transition: border-color var(--transition-fast), color var(--transition-fast);
}

.prose :global(a:hover) {
    color: var(--accent);
    border-bottom-color: var(--accent);
}

.prose :global(ul),
.prose :global(ol) {
    margin-bottom: 1.4em;
    padding-left: 22px;
}

.prose :global(ul) {
    list-style: none;
    padding-left: 0;
}

.prose :global(ul li) {
    position: relative;
    padding-left: 22px;
}

.prose :global(ul li)::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-4);
}

.prose :global(ol) {
    list-style: decimal;
}

.prose :global(ol li)::marker {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.85em;
}

.prose :global(li) {
    margin-bottom: 0.5em;
}

.prose :global(strong) {
    color: var(--text);
    font-weight: 600;
}

.prose :global(blockquote) {
    margin: 2em 0;
    padding: 4px 0 4px 22px;
    border-left: 2px solid var(--accent);
    color: var(--text);
    font-size: 19px;
    line-height: 1.6;
}

.prose :global(blockquote p:last-child) {
    margin-bottom: 0;
}

.prose :global(code) {
    padding: 2px 6px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--text);
    font: 0.85em var(--font-mono);
}

.prose :global(pre) {
    margin: 1.8em 0;
    padding: 18px 20px;
    overflow-x: auto;
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
}

.prose :global(pre code) {
    padding: 0;
    background: none;
    border: 0;
}

.prose :global(table) {
    width: 100%;
    margin: 1.8em 0;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.55;
}

.prose :global(th),
.prose :global(td) {
    padding: 12px 14px;
    border: 1px solid var(--line-strong);
    text-align: left;
    vertical-align: top;
}

.prose :global(th) {
    color: var(--text);
    background: var(--bg-raised);
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.prose :global(hr) {
    margin: 3em 0;
    border: 0;
    border-top: 1px solid var(--line);
}

.prose :global(img) {
    max-width: 100%;
    height: auto;
    margin: 2em 0;
    border: 1px solid var(--line);
}

@media (max-width: 640px) {
    .prose {
        font-size: 16px;
    }

    .prose :global(table) {
        display: block;
        overflow-x: auto;
    }

    .post-label {
        margin-top: 36px;
    }
}
</style>
