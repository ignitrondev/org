---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles.css';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const dateFormatted = entry.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<BaseLayout
    title={`${entry.data.title} - IgnitronDev Blog`}
    description={entry.data.excerpt}
>
    <Navbar />
    <main class="main-content">
        <section class="blog-post-hero">
            <span class="blog-post-badge" style={`color: ${entry.data.color}; border-color: ${entry.data.color};`}>{entry.data.label}</span>
            <h1 class="blog-post-title">{entry.data.title}</h1>
            <div class="blog-post-meta">
                <time>{dateFormatted}</time>
                <span>·</span>
                <span>Bima Adam Nugraha</span>
            </div>
        </section>

        <section class="blog-post-content">
            <div class="prose prose-invert">
                <Content />
            </div>
        </section>
    </main>
    <Footer />
</BaseLayout>

<style>
/* Blog post — studio layout */

.blog-post-hero {
    max-width: 820px;
    margin: 0 auto;
    padding: 190px 24px 70px;
    text-align: center;
}

.blog-post-badge {
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid;
    font: 700 10px var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 24px;
}

.blog-post-title {
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 22px;
    color: #fff;
}

.blog-post-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #71717a;
    font: 500 12px var(--font-mono);
}

.blog-post-content {
    max-width: 800px;
    margin: 0 auto 100px;
    padding: 0 24px;
    color: #a1a1aa;
    font-size: 17px;
    line-height: 1.8;
}

/* Prose styles for markdown content */
.prose h1, .prose h2, .prose h3, .prose h4 {
    color: #fff;
    margin-top: 2em;
    margin-bottom: 1em;
    font-weight: 700;
}
.prose h2 { font-size: 24px; letter-spacing: -0.02em; }
.prose h3 { font-size: 20px; }
.prose p {
    margin-bottom: 1.5em;
}
.prose a {
    color: #f4f4f5;
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 244, 245, 0.3);
    transition: border-color 0.2s ease;
}
.prose a:hover {
    border-bottom-color: #f4f4f5;
}
.prose ul, .prose ol {
    margin-bottom: 1.5em;
    padding-left: 24px;
}
.prose li {
    margin-bottom: 0.5em;
}
.prose strong {
    color: #fff;
    font-weight: 600;
}
.prose blockquote {
    border-left: 2px solid #a1a1aa;
    padding-left: 20px;
    margin-left: 0;
    margin-right: 0;
    font-style: italic;
    color: #71717a;
    background: rgba(255, 255, 255, 0.03);
    padding: 16px 16px 16px 20px;
}
.prose img {
    max-width: 100%;
    height: auto;
    margin: 2em 0;
}

@media (max-width: 760px) {
    .blog-post-hero {
        padding-top: 150px;
    }
}
</style>
