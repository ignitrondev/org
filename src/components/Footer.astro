---
import C from './C.astro';
const base = import.meta.env.BASE_URL;
---

<section class="section cta" id="contact">
    <div class="container container-sm">
        <div class="cta-card">
            <div class="cta-icon" aria-hidden="true">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2v20M2 12h20" /><circle cx="12" cy="12" r="7" />
                </svg>
            </div>
            <h2 class="cta-title"><C en="Have a difficult system to think through?" id="Punya sistem rumit yang perlu dipikirkan?" zh="有一个棘手的系统需要梳理吗？" /></h2>
            <p class="cta-subtitle"><C en="Talk to IgnitronDev about architecture, infrastructure, or the next useful thing to build." id="Bicara dengan IgnitronDev tentang arsitektur, infrastruktur, atau hal berguna berikutnya yang akan dibangun." zh="与 IgnitronDev 讨论架构、基础设施或下一个值得构建的事物。" /></p>
            <div class="cta-buttons">
                <a href="https://github.com/ignitrondev" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg"><C en="Follow on GitHub" id="Ikuti di GitHub" zh="在 GitHub 关注" /></a>
                <a href="mailto:info@ignitrondev.space?subject=Hello%20IgnitronDev" class="btn btn-outline btn-lg"><C en="Start a conversation" id="Mulai percakapan" zh="开始交流" /></a>
            </div>
        </div>
    </div>
</section>

<footer class="footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href={base} class="footer-logo">
                    <div class="footer-logo-icon"><img src={`${base}images/ignitron.png`} alt="" width="32" height="32" /></div>
                    <span>Ignitron<span>Dev</span></span>
                </a>
                <p class="footer-desc"><C en="An independent engineering studio for software systems, cloud infrastructure, and technical products." id="Studio engineering independen untuk sistem software, infrastruktur cloud, dan produk teknis." zh="专注于软件系统、云基础设施与技术产品的独立工程工作室。" /></p>
            </div>
            <div class="footer-links">
                <h4><C en="Work" id="Karya" zh="作品" /></h4>
                <ul>
                    <li><a href="https://app.ignitrondev.space" target="_blank" rel="noopener noreferrer">IgnitronDev Router</a></li>
                    <li><a href="https://shipradar.my.id" target="_blank" rel="noopener noreferrer">ShipRadar</a></li>
                    <li><a href="https://ignitron-medic-ui.pages.dev/" target="_blank" rel="noopener noreferrer">Ignitron Clinical UI</a></li>
                    <li><a href="https://www.npmjs.com/package/@ignitrondev/odontogram" target="_blank" rel="noopener noreferrer">@ignitrondev/odontogram</a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h4><C en="Resources" id="Sumber daya" zh="资源" /></h4>
                <ul>
                    <li><a href={`${base}#approach`}><C en="Product approach" id="Pendekatan produk" zh="产品方法" /></a></li>
                    <li><a href={`${base}foundry/`}><C en="Clinical UI catalog" id="Katalog Clinical UI" zh="临床 UI 目录" /></a></li>
                    <li><a href={`${base}blog/`}>Blog</a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h4><C en="Contact" id="Kontak" zh="联系" /></h4>
                <ul>
                    <li class="footer-contact-item"><a href="mailto:info@ignitrondev.space">info@ignitrondev.space</a></li>
                    <li class="footer-contact-item"><a href="https://github.com/ignitrondev" target="_blank" rel="noopener noreferrer">GitHub · ignitrondev</a></li>
                    <li class="footer-contact-item"><a href="https://instagram.com/ignitrondev" target="_blank" rel="noopener noreferrer">Instagram · @ignitrondev</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 IgnitronDev · <C en="Independent products" id="Produk independen" zh="独立产品" /></p>
        </div>
    </div>
</footer>
