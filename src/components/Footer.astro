---
import C from './C.astro';
const base = import.meta.env.BASE_URL;
---

<section class="section cta" id="contact">
    <div class="container container-sm">
        <div class="cta-card">
            <div class="cta-icon" aria-hidden="true">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2v20M2 12h20" /><circle cx="12" cy="12" r="7" />
                </svg>
            </div>
            <h2 class="cta-title"><C en="Help shape the first release" id="Bantu membentuk rilis pertama" zh="共同打造首个版本" /></h2>
            <p class="cta-subtitle"><C en="We are looking for dental clinicians and EMR developers to validate the odontogram workflow and integration contract." id="Kami mencari dokter gigi dan developer EMR untuk memvalidasi workflow odontogram serta kontrak integrasinya." zh="我们正在寻找牙科临床医生和 EMR 开发者，共同验证牙位图工作流与集成契约。" /></p>
            <div class="cta-buttons">
                <a href="mailto:admin@bimafreelance.site?subject=Ignitron%20Clinical%20UI%20Pilot" class="btn btn-primary btn-lg"><C en="Join the pilot" id="Ikuti pilot" zh="加入试点" /></a>
                <a href={`${base}foundry/`} class="btn btn-outline btn-lg"><C en="View component catalog" id="Lihat katalog komponen" zh="查看组件目录" /></a>
            </div>
        </div>
    </div>
</section>

<footer class="footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href={base} class="footer-logo">
                    <div class="footer-logo-icon"><img src={`${base}images/ignitron.png`} alt="" width="32" height="32" /></div>
                    <span>Ignitron<span>Dev</span></span>
                </a>
                <p class="footer-desc"><C en="Clinical UI infrastructure for healthcare developers. Complex workflows, clear data contracts, no hidden backend dependency." id="Infrastruktur UI klinis untuk developer healthcare. Workflow kompleks, kontrak data jelas, tanpa ketergantungan backend tersembunyi." zh="面向医疗开发者的临床 UI 基础设施：复杂工作流、清晰的数据契约、无隐藏后端依赖。" /></p>
            </div>
            <div class="footer-links">
                <h4><C en="Components" id="Komponen" zh="组件" /></h4>
                <ul>
                    <li><a href="https://ignitron-medic-ui.pages.dev/" target="_blank" rel="noopener noreferrer">Odontogram docs</a></li>
                    <li><a href={`${base}#components`}>Body Map</a></li>
                    <li><a href={`${base}#components`}>Growth Chart</a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h4><C en="Resources" id="Sumber daya" zh="资源" /></h4>
                <ul>
                    <li><a href={`${base}foundry/`}><C en="Component catalog" id="Katalog komponen" zh="组件目录" /></a></li>
                    <li><a href={`${base}#principles`}><C en="Product principles" id="Prinsip produk" zh="产品原则" /></a></li>
                    <li><a href={`${base}blog/`}>Blog</a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h4><C en="Contact" id="Kontak" zh="联系" /></h4>
                <ul>
                    <li class="footer-contact-item"><a href="mailto:admin@bimafreelance.site">admin@bimafreelance.site</a></li>
                    <li class="footer-contact-item"><a href="https://github.com/ignitrondev" target="_blank" rel="noopener noreferrer">GitHub · ignitrondev</a></li>
                    <li class="footer-contact-item"><a href="https://instagram.com/ignitrondev" target="_blank" rel="noopener noreferrer">Instagram · @ignitrondev</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 IgnitronDev · <C en="Built for safer clinical software" id="Dibangun untuk software klinis yang lebih aman" zh="为更安全的临床软件而构建" /></p>
        </div>
    </div>
</footer>
