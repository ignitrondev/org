---
import C from './C.astro';
const base = import.meta.env.BASE_URL;
---

<section class="cta" id="contact">
    <div class="container">
        <div class="cta-card corners">
            <div class="cta-copy">
                <p class="sec-kicker"><b>[05]</b><C en="Contact" id="Kontak" zh="联系" /></p>
                <h2 class="cta-title"><C en="Have a difficult system to think through?" id="Punya sistem rumit yang perlu dipikirkan?" zh="有一个棘手的系统需要梳理吗？" /></h2>
                <p class="cta-subtitle"><C en="Talk to IgnitronDev about architecture, infrastructure, or the next useful thing to build." id="Bicara dengan IgnitronDev tentang arsitektur, infrastruktur, atau hal berguna berikutnya yang akan dibangun." zh="与 IgnitronDev 讨论架构、基础设施或下一个值得构建的事物。" /></p>
            </div>
            <div class="cta-actions">
                <a href="mailto:info@ignitrondev.space?subject=Hello%20IgnitronDev" class="cta-mail">
                    <span class="cta-mail-label"><C en="Start a conversation" id="Mulai percakapan" zh="开始交流" /></span>
                    <span class="cta-mail-address">info@ignitrondev.space<span aria-hidden="true">→</span></span>
                </a>
                <a href="https://github.com/ignitrondev" target="_blank" rel="noopener noreferrer" class="btn btn-outline"><C en="Follow on GitHub" id="Ikuti di GitHub" zh="在 GitHub 关注" /><span class="btn-arrow" aria-hidden="true">↗</span></a>
            </div>
        </div>
    </div>
</section>

<footer class="footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href={base} class="footer-logo">
                    <span class="footer-logo-mark"><img src={`${base}images/ignitron-mark.png`} alt="" width="24" height="24" /></span>
                    <span>Ignitron<span>Dev</span></span>
                </a>
                <p class="footer-desc"><C en="An independent engineering studio for software systems, cloud infrastructure, and technical products." id="Studio engineering independen untuk sistem software, infrastruktur cloud, dan produk teknis." zh="专注于软件系统、云基础设施与技术产品的独立工程工作室。" /></p>
            </div>
            <div class="footer-links">
                <h4><C en="Work" id="Karya" zh="作品" /></h4>
                <ul>
                    <li><a href="https://shipradar.my.id" target="_blank" rel="noopener noreferrer">ShipRadar</a></li>
                    <li><a href="https://magma.ignitrondev.space" target="_blank" rel="noopener noreferrer">IGN Volcano</a></li>
                    <li><a href="https://ignitron-medic-ui.pages.dev/" target="_blank" rel="noopener noreferrer">Ignitron Clinical UI</a></li>
                    <li><a href="https://www.npmjs.com/package/@ignitrondev/odontogram" target="_blank" rel="noopener noreferrer">@ignitrondev/odontogram</a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h4><C en="Resources" id="Sumber daya" zh="资源" /></h4>
                <ul>
                    <li><a href={`${base}#approach`}><C en="About IgnitronDev" id="Tentang IgnitronDev" zh="关于 IgnitronDev" /></a></li>
                    <li><a href={`${base}about/bima/`}><C en="About the founder" id="Tentang founder" zh="关于创始人" /></a></li>
                    <li><a href={`${base}foundry/`}><C en="Clinical UI catalog" id="Katalog Clinical UI" zh="临床 UI 目录" /></a></li>
                    <li><a href={`${base}blog/`}>Blog</a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h4><C en="Contact" id="Kontak" zh="联系" /></h4>
                <ul>
                    <li><a href="mailto:info@ignitrondev.space">info@ignitrondev.space</a></li>
                    <li><a href="https://github.com/ignitrondev" target="_blank" rel="noopener noreferrer">GitHub · ignitrondev</a></li>
                    <li><a href="https://instagram.com/ignitrondev" target="_blank" rel="noopener noreferrer">Instagram · @ignitrondev</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 IgnitronDev · <C en="Independent products" id="Produk independen" zh="独立产品" /></p>
            <p>EST. 2019 · ignitrondev.space</p>
        </div>
        <p class="footer-wordmark" aria-hidden="true">IGNITRONDEV</p>
    </div>
</footer>

<style>
    .cta {
        padding: var(--section-padding) 0;
        border-bottom: 1px solid var(--line);
    }

    .cta-card {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
        gap: 48px;
        align-items: end;
        padding: 56px;
        border: 1px solid var(--line-strong);
        background:
            radial-gradient(ellipse 60% 80% at 100% 100%, rgba(255, 178, 36, 0.08), transparent 70%),
            var(--bg-raised);
    }

    .cta-title {
        margin-top: 24px;
        font-size: clamp(34px, 4.4vw, 56px);
        font-weight: 600;
        line-height: 1.02;
        letter-spacing: -0.045em;
    }

    .cta-subtitle {
        margin-top: 20px;
        max-width: 520px;
        color: var(--text-2);
        font-size: 17px;
        line-height: 1.7;
    }

    .cta-actions {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
    }

    .cta-mail {
        display: block;
        padding: 20px 22px;
        background: var(--text);
        color: var(--bg);
        transition: background-color var(--transition-fast);
    }

    .cta-mail:hover {
        background: var(--accent);
        color: #111;
    }

    .cta-mail-label {
        display: block;
        font: 500 10px/1 var(--font-mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0.65;
    }

    .cta-mail-address {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-top: 12px;
        font-size: clamp(18px, 2vw, 22px);
        font-weight: 600;
        letter-spacing: -0.03em;
        overflow-wrap: anywhere;
    }

    .cta-mail-address span {
        transition: transform var(--transition-base);
    }

    .cta-mail:hover .cta-mail-address span {
        transform: translateX(4px);
    }

    /* Footer */
    .footer {
        padding: 72px 0 0;
        overflow: hidden;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 1.6fr repeat(3, 1fr);
        gap: 40px;
        padding-bottom: 56px;
    }

    .footer-logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        font-size: 16px;
        font-weight: 600;
        letter-spacing: -0.03em;
    }

    .footer-logo > span:last-child span {
        color: var(--text-3);
    }

    .footer-logo-mark {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        background: #fff;
    }

    .footer-desc {
        max-width: 300px;
        color: var(--text-3);
        font-size: 14px;
        line-height: 1.65;
    }

    .footer-links h4 {
        margin-bottom: 18px;
        color: var(--text-3);
        font: 500 10px/1 var(--font-mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .footer-links li + li {
        margin-top: 10px;
    }

    .footer-links a {
        color: var(--text-2);
        font-size: 14px;
        transition: color var(--transition-fast);
    }

    .footer-links a:hover {
        color: var(--text);
    }

    .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px;
        padding: 20px 0;
        border-top: 1px solid var(--line);
        color: var(--text-3);
        font: 400 11px/1.5 var(--font-mono);
        letter-spacing: 0.04em;
    }

    .footer-wordmark {
        margin: 8px 0 -0.2em;
        color: transparent;
        -webkit-text-stroke: 1px var(--line-strong);
        font-size: clamp(40px, 14vw, 180px);
        font-weight: 700;
        line-height: 0.8;
        letter-spacing: -0.06em;
        text-align: center;
        white-space: nowrap;
        user-select: none;
    }

    @media (max-width: 1000px) {
        .cta-card {
            grid-template-columns: 1fr;
            align-items: start;
        }

        .footer-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 640px) {
        .cta-card {
            padding: 32px 20px;
            gap: 32px;
        }

        .footer-grid {
            grid-template-columns: 1fr;
            gap: 32px;
        }

        .footer-bottom {
            flex-direction: column;
        }
    }
</style>
