---
import T from './T.astro';
const base = import.meta.env.BASE_URL;
---

<section class="section cta" id="contact">
    <div class="container container-sm">
        <div class="cta-card">
            <div class="cta-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" />
                </svg>
            </div>
            <h2 class="cta-title"><T tag="span" key="footer.ctaTitle" /></h2>
            <p class="cta-subtitle"><T tag="span" key="footer.ctaSubtitle" /></p>
            <div class="cta-buttons">
                <button class="btn btn-primary btn-lg"><T tag="span" key="footer.ctaBtn1" /></button>
                <button class="btn btn-outline btn-lg"><T tag="span" key="footer.ctaBtn2" /></button>
            </div>
        </div>
    </div>
</section>

<footer class="footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href={`${base}`} class="footer-logo">
                    <div class="footer-logo-icon">
                        <img src={`${base}images/ignitron.png`} alt="IgnitronDev" width="32" height="32" />
                    </div>
                    <span>Ignitron<span>Dev</span></span>
                </a>
                <p class="footer-desc"><T tag="span" key="footer.desc" /></p>
            </div>
            <div class="footer-links">
                <h4><T tag="span" key="footer.platforms" /></h4>
                <ul>
                    <li><a href={`${base}#platforms`}>ShipRadar</a></li>
                    <li><a href={`${base}#platforms`}>FactorySense</a></li>
                    <li><a href={`${base}#platforms`}>AssetTrack</a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h4><T tag="span" key="footer.partnership" /></h4>
                <ul>
                    <li><a href={`${base}#partners`}><T tag="span" key="footer.resellerProgram" /></a></li>
                    <li><a href={`${base}#partners`}><T tag="span" key="footer.whitelabelPartner" /></a></li>
                    <li><a href={`${base}#partners`}><T tag="span" key="footer.techPartner" /></a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h4><T tag="span" key="footer.contact" /></h4>
                <ul>
                    <li class="footer-contact-item">partners@ignitrondev.com</li>
                    <li class="footer-contact-item">WA: +62 xxx-xxxx-xxxx</li>
                    <li class="footer-contact-item">WeChat: ignitrondev</li>
                    <li class="footer-contact-item">
                        <a href="https://instagram.com/ignitrondev" target="_blank" rel="noopener noreferrer">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                            </svg>
                            @ignitrondev
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p><T tag="span" key="footer.copyright" /> <a href="https://instagram.com/xiaobima__" target="_blank" rel="noopener noreferrer">Bima Adam Nugraha</a></p>
            <div class="footer-bottom-links">
                <a href={`${base}legal/privacy`}><T tag="span" key="footer.privacy" /></a><a href={`${base}legal/terms`}><T tag="span" key="footer.terms" /></a><a href={`${base}legal/partner-agreement`}><T tag="span" key="footer.partnerAgreement" /></a>
            </div>
        </div>
    </div>
</footer>
