---
import C from './C.astro';
import LanguageToggle from './LanguageToggle.astro';

const base = import.meta.env.BASE_URL;
---

<header class="nav" id="nav">
    <nav class="container nav-inner" aria-label="Primary navigation">
        <a href={base} class="nav-logo" aria-label="IgnitronDev home">
            <span class="nav-logo-mark"><img src={`${base}images/ignitron-mark.png`} alt="" width="28" height="28" /></span>
            <span class="nav-logo-name">Ignitron<span>Dev</span></span>
        </a>

        <div class="nav-links" id="navLinks">
            <a href={`${base}#systems`}><C en="Practice" id="Praktik" zh="实践" /></a>
            <a href={`${base}#work`}><C en="Work" id="Karya" zh="作品" /></a>
            <a href={`${base}#clients`}><C en="Clients" id="Klien" zh="客户" /></a>
            <a href={`${base}#approach`}><C en="About" id="Tentang" zh="关于" /></a>
            <a href={`${base}blog/`}><C en="Blog" id="Blog" zh="博客" /></a>
            <a href={`${base}foundry/`}><C en="Clinical UI" id="Clinical UI" zh="临床 UI" /></a>
        </div>

        <div class="nav-actions">
            <LanguageToggle />
            <a href="https://github.com/ignitrondev" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm nav-cta">
                GitHub
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </a>
            <button class="nav-toggle" id="navToggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="navLinks">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>
</header>

<script>
    const nav = document.getElementById('nav');
    const toggle = document.getElementById('navToggle');
    const links = document.getElementById('navLinks');
    const mobileNav = window.matchMedia('(max-width: 980px)');
    const sectionIds = ['systems', 'work', 'clients', 'approach'];

    function isHome() {
        const path = location.pathname.replace(/\/+$/, '') || '/';
        return path === '/';
    }

    function setOpen(open: boolean) {
        const next = open && mobileNav.matches;
        links?.classList.toggle('open', next);
        nav?.classList.toggle('menu-open', next);
        toggle?.setAttribute('aria-expanded', String(next));
        document.body.style.overflow = next ? 'hidden' : '';
    }

    function currentSection() {
        if (!isHome()) return '';
        const line = (nav?.offsetHeight ?? 64) + 24;
        let current = '';
        for (const id of sectionIds) {
            const section = document.getElementById(id);
            if (section && section.getBoundingClientRect().top <= line) current = id;
        }
        return current;
    }

    function markCurrent() {
        const path = location.pathname.replace(/\/+$/, '') || '/';
        const section = currentSection();
        links?.querySelectorAll('a').forEach((link) => {
            const url = new URL(link.href, location.origin);
            const linkPath = url.pathname.replace(/\/+$/, '') || '/';
            const active = url.hash
                ? isHome() && url.hash === `#${section}`
                : linkPath !== '/' && (path === linkPath || path.startsWith(`${linkPath}/`));
            link.classList.toggle('is-current', active);
            if (active) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
        });
    }

    function onScroll() {
        nav?.classList.toggle('scrolled', window.scrollY > 8);
        markCurrent();
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    toggle?.addEventListener('click', () => setOpen(!links?.classList.contains('open')));
    links?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setOpen(false);
    });
    document.addEventListener('click', (event) => {
        if (!nav?.classList.contains('menu-open')) return;
        if (event.target instanceof Node && nav.contains(event.target)) return;
        setOpen(false);
    });
    mobileNav.addEventListener('change', () => setOpen(false));
</script>

<style>
    .nav {
        position: fixed;
        inset: 0 0 auto;
        z-index: 1000;
        height: var(--nav-height);
        overflow: visible;
        border-bottom: 1px solid transparent;
        transition: background-color var(--transition-base), border-color var(--transition-base);
    }

    .nav.scrolled,
    .nav.menu-open {
        background: rgba(8, 8, 10, 0.78);
        border-bottom-color: var(--line);
        backdrop-filter: blur(14px) saturate(140%);
        -webkit-backdrop-filter: blur(14px) saturate(140%);
    }

    .nav-inner {
        height: 100%;
        display: flex;
        align-items: center;
        gap: 32px;
    }

    .nav-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        flex: 0 1 auto;
    }

    .nav-logo-mark {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        overflow: hidden;
        background: #fff;
    }

    .nav-logo-mark img {
        width: 24px;
        height: 24px;
    }

    .nav-logo-name {
        overflow: hidden;
        font-size: 16px;
        font-weight: 600;
        letter-spacing: -0.03em;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .nav-logo-name span {
        color: var(--text-3);
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-right: auto;
    }

    .nav-links a {
        padding: 6px 10px;
        color: var(--text-2);
        font-size: 13.5px;
        transition: color var(--transition-fast);
    }

    .nav-links a:hover,
    .nav-links a.is-current {
        color: var(--text);
    }

    @media (min-width: 981px) {
        .nav-links a {
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            left: 10px;
            right: 10px;
            bottom: 0;
            height: 1px;
            background: var(--accent);
            transform: scaleX(0);
            transform-origin: left center;
            transition: transform var(--transition-fast);
        }

        .nav-links a:hover::after,
        .nav-links a:focus-visible::after,
        .nav-links a.is-current::after {
            transform: scaleX(1);
        }
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: auto;
        flex: none;
    }

    .nav-toggle {
        display: none;
        width: 42px;
        height: 42px;
        flex: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
        padding: 0;
        background: none;
        border: 1px solid var(--line-strong);
        cursor: pointer;
    }

    .nav-toggle span {
        display: block;
        width: 16px;
        height: 1.5px;
        background: var(--text);
        transition: transform var(--transition-fast), opacity var(--transition-fast);
    }

    .nav.menu-open .nav-toggle span:nth-child(1) {
        transform: translateY(6.5px) rotate(45deg);
    }

    .nav.menu-open .nav-toggle span:nth-child(2) {
        opacity: 0;
    }

    .nav.menu-open .nav-toggle span:nth-child(3) {
        transform: translateY(-6.5px) rotate(-45deg);
    }

    @media (max-width: 980px) {
        .nav-inner {
            gap: 12px;
        }

        .nav-cta {
            display: none;
        }

        .nav-toggle {
            display: flex;
        }

        .nav-links {
            position: absolute;
            top: var(--nav-height);
            left: 0;
            right: 0;
            display: none;
            flex-direction: column;
            align-items: stretch;
            gap: 0;
            margin: 0;
            padding: 8px var(--gutter) 20px;
            background: var(--bg);
            border-bottom: 1px solid var(--line);
        }

        .nav-links.open {
            display: flex;
        }

        .nav-links a {
            padding: 14px 0;
            border-bottom: 1px solid var(--line);
            font-size: 16px;
            color: var(--text);
        }

        .nav-links a:hover,
        .nav-links a.is-current {
            color: var(--accent);
        }

        .nav-links a::after {
            content: none;
        }
    }

    @media (max-width: 380px) {
        .nav-logo-name {
            font-size: 15px;
        }
    }
</style>
