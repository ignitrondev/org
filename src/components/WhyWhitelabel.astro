---
import T from './T.astro';
---
<section class="section why-whitelabel" id="why-whitelabel">
    <div class="container">
        <div class="section-header">
            <span class="section-badge"><T tag="span" key="whyWhitelabel.badge" /></span>
            <h2 class="section-title"><T tag="span" key="whyWhitelabel.title" /> <span class="text-gradient"><T tag="span" key="whyWhitelabel.titleGradient" /></span><br /><T tag="span" key="whyWhitelabel.titleSuffix" /></h2>
            <p class="section-subtitle"><T tag="span" key="whyWhitelabel.subtitle" /></p>
        </div>
        <div class="benefits-grid">
            <div class="benefit-card">
                <div class="benefit-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" /><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" /></svg></div>
                <h3 class="benefit-title"><T tag="span" key="whyWhitelabel.b1Title" /></h3>
                <p class="benefit-description"><T tag="span" key="whyWhitelabel.b1Desc" /></p>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" x2="12" y1="2" y2="22" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg></div>
                <h3 class="benefit-title"><T tag="span" key="whyWhitelabel.b2Title" /></h3>
                <p class="benefit-description"><T tag="span" key="whyWhitelabel.b2Desc" /></p>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" /><path d="m9 12 2 2 4-4" /></svg></div>
                <h3 class="benefit-title"><T tag="span" key="whyWhitelabel.b3Title" /></h3>
                <p class="benefit-description"><T tag="span" key="whyWhitelabel.b3Desc" /></p>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17" /><polyline points="16 7 22 7 22 13" /></svg></div>
                <h3 class="benefit-title"><T tag="span" key="whyWhitelabel.b4Title" /></h3>
                <p class="benefit-description"><T tag="span" key="whyWhitelabel.b4Desc" /></p>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg></div>
                <h3 class="benefit-title"><T tag="span" key="whyWhitelabel.b5Title" /></h3>
                <p class="benefit-description"><T tag="span" key="whyWhitelabel.b5Desc" /></p>
            </div>
        </div>
        <div class="comparison-grid">
            <div class="comparison-card comparison-bad">
                <div class="comparison-label">❌ Build Yourself</div>
                <div class="comparison-value">12-18 Months</div>
                <div class="comparison-detail">Development time</div>
                <div class="comparison-detail comparison-cost">$100K+ investment</div>
            </div>
            <div class="comparison-card comparison-best">
                <div class="comparison-badge">WHITE-LABEL</div>
                <div class="comparison-label">✓ White-Label Partner</div>
                <div class="comparison-value">2 Weeks</div>
                <div class="comparison-detail">Deployment time</div>
                <div class="comparison-detail comparison-cost highlight">$5K starting</div>
            </div>
            <div class="comparison-card comparison-mid">
                <div class="comparison-label">⚠️ Hire Agency</div>
                <div class="comparison-value">3-6 Months</div>
                <div class="comparison-detail">Development time</div>
                <div class="comparison-detail comparison-cost">$30K-80K typical</div>
            </div>
        </div>
    </div>
</section>
