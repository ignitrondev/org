---
import T from './T.astro';
---
<section class="section partners" id="partners">
    <div class="container">
        <div class="section-header">
            <span class="section-badge"><T tag="span" key="partnership.badge" /></span>
            <h2 class="section-title"><T tag="span" key="partnership.title" /> <span class="text-gradient"><T tag="span" key="partnership.titleGradient" /></span></h2>
            <p class="section-subtitle"><T tag="span" key="partnership.subtitle" /></p>
        </div>
        <div class="tiers-grid">
            <div class="tier-card">
                <div class="tier-icon" style="--tier-color: #CD7F32;"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg></div>
                <h3 class="tier-name"><T tag="span" key="partnership.t1Name" /></h3>
                <div class="tier-price"><T tag="span" key="partnership.t1Price" /></div>
                <div class="tier-commission"><T tag="span" key="partnership.t1Commission" /></div>
                <ul class="tier-features">
                    <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg><T tag="span" key="partnership.t1f1" /></li>
                    <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg><T tag="span" key="partnership.t1f2" /></li>
                    <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg><T tag="span" key="partnership.t1f3" /></li>
                </ul>
                <button class="btn btn-secondary btn-block"><T tag="span" key="partnership.t1Cta" /></button>
            </div>
            <div class="tier-card tier-card-popular">
                <div class="tier-badge">MOST POPULAR</div>
                <div class="tier-icon" style="--tier-color: #C0C0C0;"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></div>
                <h3 class="tier-name"><T tag="span" key="partnership.t2Name" /></h3>
                <div class="tier-price">$2,500<span>/year</span></div>
                <div class="tier-commission tier-commission-highlight"><T tag="span" key="partnership.t2Commission" /></div>
                <ul class="tier-features">
                    <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg><T tag="span" key="partnership.t2f1" /></li>
                    <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg><T tag="span" key="partnership.t2f2" /></li>
                    <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg><T tag="span" key="partnership.t2f3" /></li>
                </ul>
                <button class="btn btn-primary btn-block"><T tag="span" key="partnership.t2Cta" /></button>
            </div>
            <div class="tier-card">
                <div class="tier-icon" style="--tier-color: #FFD700;"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6" /><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" /></svg></div>
                <h3 class="tier-name"><T tag="span" key="partnership.t3Name" /></h3>
                <div class="tier-price">$10,000<span>/year</span></div>
                <div class="tier-commission"><T tag="span" key="partnership.t3Commission" /></div>
                <ul class="tier-features">
                    <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg><T tag="span" key="partnership.t3f1" /></li>
                    <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg><T tag="span" key="partnership.t3f2" /></li>
                    <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg><T tag="span" key="partnership.t3f3" /></li>
                </ul>
                <button class="btn btn-secondary btn-block"><T tag="span" key="partnership.t3Cta" /></button>
            </div>
        </div>
    </div>
</section>
