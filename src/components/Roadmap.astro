---
import T from './T.astro';
---
<section class="roadmap-section" id="roadmap">
    <div class="container">
        <div class="section-header text-center">
            <div class="section-badge"><T tag="span" key="roadmap.badge" /></div>
            <h2 class="section-title"><T tag="span" key="roadmap.title" /> <span class="text-gradient"><T tag="span" key="roadmap.titleGradient" /></span></h2>
            <p class="section-subtitle"><T tag="span" key="roadmap.subtitle" /></p>
        </div>
        <div class="roadmap-grid">
            <div class="roadmap-item">
                <div class="roadmap-day"><T tag="span" key="roadmap.step1Day" /></div>
                <div class="roadmap-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg></div>
                <h3 class="roadmap-label"><T tag="span" key="roadmap.step1Title" /></h3>
                <p class="roadmap-desc"><T tag="span" key="roadmap.step1Desc" /></p>
            </div>
            <div class="roadmap-item">
                <div class="roadmap-day"><T tag="span" key="roadmap.step2Day" /></div>
                <div class="roadmap-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z" /><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" /></svg></div>
                <h3 class="roadmap-label"><T tag="span" key="roadmap.step2Title" /></h3>
                <p class="roadmap-desc"><T tag="span" key="roadmap.step2Desc" /></p>
            </div>
            <div class="roadmap-item">
                <div class="roadmap-day"><T tag="span" key="roadmap.step3Day" /></div>
                <div class="roadmap-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2" ry="2" /><path d="M7 2v4" /><path d="M17 2v4" /><path d="M2 10h20" /></svg></div>
                <h3 class="roadmap-label"><T tag="span" key="roadmap.step3Title" /></h3>
                <p class="roadmap-desc"><T tag="span" key="roadmap.step3Desc" /></p>
            </div>
            <div class="roadmap-item">
                <div class="roadmap-day"><T tag="span" key="roadmap.step4Day" /></div>
                <div class="roadmap-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg></div>
                <h3 class="roadmap-label"><T tag="span" key="roadmap.step4Title" /></h3>
                <p class="roadmap-desc"><T tag="span" key="roadmap.step4Desc" /></p>
            </div>
        </div>
    </div>
</section>
