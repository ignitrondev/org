---
interface Props {
    tag?: 'span' | 'p' | 'h1' | 'h2' | 'h3' | 'h4' | 'div';
    en: string;
    id: string;
    zh: string;
    class?: string;
}

const { tag: Tag = 'span', en, id, zh, class: className } = Astro.props;
---

<Tag
    class={className}
    data-i18n="clinical-copy"
    data-t-en={en}
    data-t-id={id}
    data-t-zh={zh}
>{en}</Tag>
