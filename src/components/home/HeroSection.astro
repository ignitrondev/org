---
import C from '../C.astro';
import HeroLogo3D from '../HeroLogo3D';
---

<section class="hero" id="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-grid">
        <div class="hero-copy">
            <p class="hero-kicker"><span class="status-dot"></span><C en="Independent engineering studio" id="Studio engineering independen" zh="独立工程工作室" /><span class="hero-kicker-sep">/</span><span>EST. 2019</span></p>
            <h1><C en="Systems that" id="Sistem yang" zh="经得起考验的" /><br /><span class="hero-title-quiet"><C en="hold up." id="tahan uji." zh="系统。" /></span></h1>
            <p class="hero-sub"><C en="IgnitronDev designs and builds the technical foundations behind useful software: architecture, backend systems, cloud infrastructure, data flows, and AI systems that can be understood and operated." id="IgnitronDev merancang dan membangun fondasi teknis di balik software yang berguna: arsitektur, sistem backend, infrastruktur cloud, aliran data, dan sistem AI yang dapat dipahami serta dioperasikan." zh="IgnitronDev 设计并构建实用软件背后的技术基础：架构、后端系统、云基础设施、数据流和可理解、可运营的 AI 系统。" /></p>
            <div class="hero-cta">
                <a href="#work" class="btn btn-primary btn-lg"><C en="See the work" id="Lihat karya kami" zh="查看作品" /><span class="btn-arrow" aria-hidden="true">→</span></a>
                <a href="mailto:info@ignitrondev.space?subject=Hello%20IgnitronDev" class="btn btn-outline btn-lg"><C en="Start a conversation" id="Mulai percakapan" zh="开始交流" /></a>
            </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
            <img class="hero-visual-fallback" src="/images/ignitron-mark.png" alt="" width="160" height="160" />
            <div class="hero-logo-3d">
                <HeroLogo3D client:visible />
            </div>
        </div>
    </div>

    <div class="container">
        <dl class="hero-stats">
            <div><dt><C en="Founded" id="Berdiri" zh="成立" /></dt><dd>2019</dd></div>
            <div><dt><C en="Live products" id="Produk aktif" zh="上线产品" /></dt><dd>02</dd></div>
            <div><dt><C en="Client systems" id="Sistem klien" zh="客户系统" /></dt><dd>07</dd></div>
            <div><dt><C en="Open-source packages" id="Paket open-source" zh="开源包" /></dt><dd>01</dd></div>
        </dl>
    </div>
</section>

<style>
    .hero {
        position: relative;
        padding: calc(var(--nav-height) + 88px) 0 0;
        border-bottom: 1px solid var(--line);
        overflow: hidden;
    }

    .hero-bg {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            linear-gradient(var(--line) 1px, transparent 1px) center top / 56px 56px,
            linear-gradient(90deg, var(--line) 1px, transparent 1px) center top / 56px 56px;
        mask-image: linear-gradient(to bottom, #000 30%, transparent 92%);
    }

    :global(.hero-intro) .hero-copy > *,
    :global(.hero-intro) .hero-visual,
    :global(.hero-intro) .hero-stats > div {
        opacity: 0;
    }

    .hero-grid {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 64px;
        align-items: center;
    }

    .hero-kicker {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        color: var(--text-2);
        font: 500 11px/1.4 var(--font-mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .hero-kicker-sep {
        color: var(--text-4);
    }

    .hero h1 {
        margin: 28px 0 0;
        font-size: clamp(52px, 7vw, 96px);
        font-weight: 600;
        line-height: 0.95;
        letter-spacing: -0.06em;
    }

    .hero-title-quiet {
        color: var(--text-3);
    }

    .hero-sub {
        max-width: 560px;
        margin: 28px 0 36px;
        color: var(--text-2);
        font-size: clamp(16px, 1.45vw, 18px);
        line-height: 1.7;
    }

    .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    /* 3D logo: no frame, just the mark and its contact shadow */
    .hero-visual {
        position: relative;
        height: 520px;
    }

    .hero-visual-fallback {
        display: none;
        position: absolute;
        top: 50%;
        left: 50%;
        width: 120px;
        height: 120px;
        transform: translate(-50%, -50%);
        padding: 10px;
        background: #fff;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
    }

    .hero-logo-3d {
        position: absolute;
        inset: 0;
        touch-action: pan-y;
    }

    .hero-logo-3d :global(canvas) {
        display: block;
        width: 100% !important;
        height: 100% !important;
    }

    /* Stats */
    .hero-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        margin-top: 88px;
        border-top: 1px solid var(--line);
    }

    .hero-stats div {
        padding: 28px 24px 32px;
        border-left: 1px solid var(--line);
    }

    .hero-stats div:last-child {
        border-right: 1px solid var(--line);
    }

    .hero-stats dt {
        color: var(--text-3);
        font: 500 10px/1.4 var(--font-mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .hero-stats dd {
        margin-top: 14px;
        font-size: 40px;
        font-weight: 500;
        line-height: 1;
        letter-spacing: -0.04em;
        font-variant-numeric: tabular-nums;
    }

    @media (max-width: 1000px) {
        .hero-grid {
            grid-template-columns: 1fr;
            gap: 56px;
        }

        .hero-visual {
            height: 400px;
        }
    }

    @media (max-width: 768px) {
        .hero {
            padding-top: calc(var(--nav-height) + 56px);
        }

        .hero h1 {
            font-size: clamp(46px, 13vw, 64px);
        }

        .hero-visual {
            height: 340px;
        }

        .hero-stats {
            grid-template-columns: 1fr 1fr;
            margin-top: 64px;
        }

        .hero-stats div {
            padding: 22px 16px 24px;
        }

        .hero-stats div:nth-child(2n) {
            border-right: 1px solid var(--line);
        }

        .hero-stats div:nth-child(-n + 2) {
            border-bottom: 1px solid var(--line);
        }

        .hero-stats dd {
            font-size: 32px;
        }
    }

    @media (max-width: 480px) {
        .hero h1 {
            font-size: clamp(40px, 12.5vw, 52px);
        }

        .hero-cta .btn {
            width: 100%;
        }

        .hero-visual {
            height: 300px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-logo-3d {
            display: none;
        }

        .hero-visual-fallback {
            display: block;
        }
    }
</style>
