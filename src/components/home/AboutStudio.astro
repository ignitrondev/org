---
import C from '../C.astro';

const focus = [
    'Software architecture',
    'Backend & distributed systems',
    'Cloud & DevOps',
    'Data infrastructure',
    'Networking & edge systems',
    'AI infrastructure',
    'Developer tools',
    'Internal & operational systems',
];

const steps = [
    {
        verb: { en: 'Build', id: 'Bangun', zh: '构建' },
        body: {
            en: 'Start from the problem and its constraints, not a template.',
            id: 'Mulai dari masalah dan batasannya, bukan dari template.',
            zh: '从问题与约束出发，而不是从模板出发。',
        },
    },
    {
        verb: { en: 'Deploy', id: 'Deploy', zh: '部署' },
        body: {
            en: 'Ship through repeatable pipelines into real infrastructure.',
            id: 'Rilis lewat pipeline yang bisa diulang ke infrastruktur nyata.',
            zh: '通过可重复的流水线交付到真实基础设施。',
        },
    },
    {
        verb: { en: 'Operate', id: 'Operasikan', zh: '运营' },
        body: {
            en: 'Keep runtime behavior visible and the system legible.',
            id: 'Jaga perilaku runtime tetap terlihat dan sistem mudah dipahami.',
            zh: '让运行时行为可见，让系统清晰易懂。',
        },
    },
    {
        verb: { en: 'Improve', id: 'Tingkatkan', zh: '改进' },
        body: {
            en: 'Feed what production teaches back into the design.',
            id: 'Bawa pelajaran dari production kembali ke desain.',
            zh: '把生产环境中的经验反馈到设计中。',
        },
    },
];
---

<section class="section about" id="approach">
    <div class="container">
        <div class="about-grid">
            <div class="about-statement">
                <p class="sec-kicker"><b>[04]</b><C en="About IgnitronDev" id="Tentang IgnitronDev" zh="关于 IgnitronDev" /></p>
                <h2 class="sec-title"><C en="We build systems," id="Kami membangun sistem," zh="我们构建系统，" /><br /><span class="text-gradient"><C en="not just software." id="bukan sekadar software." zh="不只是软件。" /></span></h2>
                <p><C en="IgnitronDev exists to engineer the systems behind real-world products. We start with the problem, architecture, constraints, and how the system needs to operate—not templates or predefined packages." id="IgnitronDev ada untuk merekayasa sistem di balik produk dunia nyata. Kami mulai dari masalah, arsitektur, batasan, dan bagaimana sistem harus beroperasi—bukan template atau paket yang sudah ditentukan." zh="IgnitronDev 致力于构建真实产品背后的系统。我们从问题、架构、约束和系统在现实中应如何运行开始，而非模板或预设套餐。" /></p>
                <a href="/about/bima/" class="about-founder">
                    <span class="about-founder-mark">BA</span>
                    <div><strong>Bima Adam Nugraha</strong><span>Founder &amp; CEO · Beatz Bimz</span></div>
                    <span class="about-founder-arrow" aria-hidden="true">→</span>
                </a>
            </div>

            <div class="about-focus">
                <p class="about-focus-label"><span>OUR FOCUS</span><span>08</span></p>
                <ul class="focus-grid">
                    {focus.map((item, i) => (
                        <li><span>{String(i + 1).padStart(2, '0')}</span>{item}</li>
                    ))}
                </ul>
            </div>
        </div>

        <ol class="process" aria-label="How we work">
            {steps.map((step, i) => (
                <li>
                    <span class="process-index">{String(i + 1).padStart(2, '0')}</span>
                    <h3><C en={step.verb.en} id={step.verb.id} zh={step.verb.zh} /></h3>
                    <p><C en={step.body.en} id={step.body.id} zh={step.body.zh} /></p>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .about-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        gap: 96px;
        align-items: start;
    }

    .about-statement > p:not(.sec-kicker) {
        margin-top: 28px;
        max-width: 540px;
        color: var(--text-2);
        font-size: 17px;
        line-height: 1.75;
    }

    .about-founder {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 36px;
        padding-top: 24px;
        border-top: 1px solid var(--line);
        max-width: 540px;
    }

    .about-founder-arrow {
        margin-left: auto;
        color: var(--text-3);
        transition: transform var(--transition-base), color var(--transition-fast);
    }

    .about-founder:hover .about-founder-arrow {
        color: var(--accent);
        transform: translateX(4px);
    }

    .about-founder-mark {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border: 1px solid var(--accent-line);
        background: var(--accent-soft);
        color: var(--accent);
        font: 600 12px/1 var(--font-mono);
    }

    .about-founder strong,
    .about-founder div span {
        display: block;
    }

    .about-founder strong {
        font-size: 15px;
        font-weight: 600;
    }

    .about-founder div span {
        color: var(--text-3);
        font: 400 11px/1.6 var(--font-mono);
        letter-spacing: 0.06em;
    }

    .about-focus {
        border-top: 1px solid var(--line-strong);
    }

    .about-focus-label {
        display: flex;
        justify-content: space-between;
        padding: 16px 0;
        color: var(--text-3);
        font: 500 10px/1 var(--font-mono);
        letter-spacing: 0.12em;
    }

    .focus-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-top: 1px solid var(--line);
        border-left: 1px solid var(--line);
    }

    .focus-grid li {
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 68px;
        padding: 16px 18px;
        border-right: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        color: var(--text);
        font-size: 14px;
        line-height: 1.35;
        transition: background-color var(--transition-fast);
    }

    .focus-grid li:hover {
        background: var(--bg-raised);
    }

    .focus-grid li span {
        color: var(--text-4);
        font: 500 10px/1 var(--font-mono);
    }

    /* Process pipeline */
    .process {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        margin-top: 96px;
        border-top: 1px solid var(--line-strong);
    }

    .process li {
        position: relative;
        padding: 28px 24px 8px 0;
    }

    .process li::before {
        content: '';
        position: absolute;
        top: -4px;
        left: 0;
        width: 7px;
        height: 7px;
        background: var(--bg);
        border: 1px solid var(--accent);
    }

    .process li:first-child::before {
        background: var(--accent);
    }

    .process-index {
        color: var(--text-4);
        font: 500 10px/1 var(--font-mono);
        letter-spacing: 0.12em;
    }

    .process h3 {
        margin: 18px 0 10px;
        font-size: 28px;
        font-weight: 600;
        letter-spacing: -0.04em;
    }

    .process p {
        max-width: 240px;
        color: var(--text-2);
        font-size: 14px;
        line-height: 1.65;
    }

    @media (max-width: 1000px) {
        .about-grid {
            grid-template-columns: 1fr;
            gap: 64px;
        }
    }

    @media (max-width: 768px) {
        .focus-grid {
            grid-template-columns: 1fr;
        }

        .focus-grid li {
            min-height: 56px;
        }

        .process {
            grid-template-columns: 1fr 1fr;
            row-gap: 24px;
            margin-top: 72px;
        }
    }

    @media (max-width: 480px) {
        .process {
            grid-template-columns: 1fr;
            border-top: 0;
            border-left: 1px solid var(--line-strong);
            row-gap: 8px;
        }

        .process li {
            padding: 0 0 20px 24px;
        }

        .process li::before {
            top: 2px;
            left: -4px;
        }

        .process h3 {
            margin-top: 12px;
        }
    }
</style>
