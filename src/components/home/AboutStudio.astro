---
import C from '../C.astro';
---

<section class="section studio-section" id="approach">
    <div class="container studio-grid">
        <div class="studio-statement">
            <span class="section-badge"><C en="About IgnitronDev" id="Tentang IgnitronDev" zh="关于 IgnitronDev" /></span>
            <h2><C en="We build systems," id="Kami membangun sistem," zh="我们构建系统，" /><br /><span class="text-gradient"><C en="not just software." id="bukan sekadar software." zh="不只是软件。" /></span></h2>
            <p><C en="IgnitronDev exists to engineer the systems behind real-world products. We start with the problem, architecture, constraints, and how the system needs to operate—not templates or predefined packages." id="IgnitronDev ada untuk merekayasa sistem di balik produk dunia nyata. Kami mulai dari masalah, arsitektur, batasan, dan bagaimana sistem harus beroperasi—bukan template atau paket yang sudah ditentukan." zh="IgnitronDev 致力于构建真实产品背后的系统。我们从问题、架构、约束和系统在现实中应如何运行开始，而非模板或预设套餐。" /></p>
            <p class="studio-manifesto"><C en="Build it. Deploy it. Operate it. Improve it." id="Bangun. Deploy. Operasikan. Tingkatkan." zh="构建。部署。运营。改进。" /></p>
        </div>
        <div class="studio-principles">
            <p class="focus-label">OUR FOCUS</p>
            <div class="focus-grid">
                <span>Software architecture</span><span>Backend &amp; distributed systems</span>
                <span>Cloud &amp; DevOps</span><span>Data infrastructure</span>
                <span>Networking &amp; edge systems</span><span>AI infrastructure</span>
                <span>Developer tools</span><span>Internal &amp; operational systems</span>
            </div>
            <div class="about-note"><span>01</span><p>Production software, infrastructure, and technical systems built to be operated in the real world.</p></div>
        </div>
    </div>
</section>

<style>
    .studio-section { background: #0c0c0f; border-block: 1px solid #27272a; }
    .studio-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 100px; align-items: start; }
    .studio-statement h2 { font-size: clamp(38px, 5vw, 66px); line-height: 1.04; letter-spacing: -.05em; margin: 26px 0; }
    .studio-statement p { color: #a1a1aa; font-size: 17px; line-height: 1.8; max-width: 620px; }
    .studio-manifesto { margin-top: 26px !important; color: #f4f4f5 !important; font: 600 13px var(--font-mono) !important; letter-spacing: .06em; text-transform: uppercase; }
    .studio-principles { border-top: 1px solid #3f3f46; }
    .focus-label { padding: 18px 0; color: #71717a; font: 10px var(--font-mono); letter-spacing: .1em; }
    .focus-grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid #27272a; border-left: 1px solid #27272a; }
    .focus-grid span { min-height: 72px; padding: 18px; display: flex; align-items: center; border-right: 1px solid #27272a; border-bottom: 1px solid #27272a; color: #d4d4d8; font-size: 14px; line-height: 1.35; }
    .about-note { display: grid; grid-template-columns: 45px 1fr; gap: 20px; padding: 28px 0; border-bottom: 1px solid #27272a; }
    .about-note span { color: #52525b; font: 11px var(--font-mono); }
    .about-note p { margin: 0; color: #71717a; line-height: 1.7; }

    @media(max-width:1000px){
        .studio-grid { grid-template-columns: 1fr; gap: 60px; }
    }
    @media(max-width:760px){
        .focus-grid { grid-template-columns: 1fr; }
        .focus-grid span { min-height: 56px; }
        .studio-grid { gap: 45px; }
    }
</style>
