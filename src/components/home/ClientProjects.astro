---
import C from '../C.astro';

const base = import.meta.env.BASE_URL;
---

<div class="client-projects">
    <div class="client-projects-heading">
        <span class="section-badge"><C en="Client projects" id="Proyek klien" zh="客户项目" /></span>
        <p><C en="Custom systems built around the day-to-day work of real teams." id="Sistem kustom yang dibangun mengikuti pekerjaan harian tim nyata." zh="围绕真实团队日常工作构建的定制系统。" /></p>
    </div>
    <div class="client-marquee" aria-label="Client logos: Abyzain Jaya Teknika, Rizqi Barokah Bunda, RSIA Gladiool, Booking Yamaha System, Graceful Decoration, and Zoya Cookies">
        <div class="client-marquee-track">
            <div class="client-marquee-item"><img src={`${base}images/logo-ajy.png`} alt="" width="56" height="56" /><span>ABYZAIN JAYA TEKNIKA</span></div>
            <div class="client-marquee-item"><img src={`${base}images/logo-ra-mark.svg`} alt="" width="56" height="56" /><span>RIZQI BAROKAH BUNDA · INVENTORY &amp; BOM</span></div>
            <div class="client-marquee-item"><img src={`${base}images/logo-rsia-gladiool.png`} alt="" width="56" height="56" /><span>RSIA GLADIOOL · GLADIOOL EMR</span></div>
            <div class="client-marquee-item"><img src={`${base}images/logo-yamaha.jpg`} alt="" width="56" height="56" /><span>BOOKING YAMAHA SYSTEM</span></div>
            <div class="client-marquee-item"><img src={`${base}images/logo-cashflow.jpg`} alt="" width="56" height="56" /><span>GRACEFUL DECORATION · CASHFLOW</span></div>
            <div class="client-marquee-item"><img src={`${base}images/logo-inventory-web.png`} alt="" width="56" height="56" /><span>ZOYA COOKIES · INVENTORY</span></div>
            <div class="client-marquee-item" aria-hidden="true"><img src={`${base}images/logo-ajy.png`} alt="" width="56" height="56" /><span>ABYZAIN JAYA TEKNIKA</span></div>
            <div class="client-marquee-item" aria-hidden="true"><img src={`${base}images/logo-ra-mark.svg`} alt="" width="56" height="56" /><span>RIZQI BAROKAH BUNDA · INVENTORY &amp; BOM</span></div>
            <div class="client-marquee-item" aria-hidden="true"><img src={`${base}images/logo-rsia-gladiool.png`} alt="" width="56" height="56" /><span>RSIA GLADIOOL · GLADIOOL EMR</span></div>
            <div class="client-marquee-item" aria-hidden="true"><img src={`${base}images/logo-yamaha.jpg`} alt="" width="56" height="56" /><span>BOOKING YAMAHA SYSTEM</span></div>
            <div class="client-marquee-item" aria-hidden="true"><img src={`${base}images/logo-cashflow.jpg`} alt="" width="56" height="56" /><span>GRACEFUL DECORATION · CASHFLOW</span></div>
            <div class="client-marquee-item" aria-hidden="true"><img src={`${base}images/logo-inventory-web.png`} alt="" width="56" height="56" /><span>ZOYA COOKIES · INVENTORY</span></div>
        </div>
    </div>
    <div class="client-project-card client-engagement-card">
        <div class="client-project-logo"><img src={`${base}images/logo-rsia-gladiool.png`} alt="RSIA Gladiool logo" width="52" height="52" /></div>
        <div class="client-project-copy">
            <div class="work-meta"><span>CLIENT ENGAGEMENT / 01</span><span class="work-status live"><i></i> IN PRODUCTION</span></div>
            <h3>Gladiool EMR</h3>
            <p><C en="Enterprise EMR platform for RSIA Gladiool, delivered through Gantha Studio. I handle backend, frontend, and the production infrastructure with Kubernetes and Argo CD." id="Platform EMR enterprise untuk RSIA Gladiool melalui Gantha Studio. Saya menangani backend, frontend, serta infrastruktur production dengan Kubernetes dan Argo CD." zh="通过 Gantha Studio 为 RSIA Gladiool 交付的企业级 EMR 平台。我负责后端、前端，以及使用 Kubernetes 和 Argo CD 的生产基础设施。" /></p>
            <div class="work-tags"><span>Backend</span><span>Frontend</span><span>Kubernetes</span><span>Argo CD</span></div>
        </div>
    </div>
</div>

<style>
    .client-projects { margin-top: 70px; }
    .client-projects-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 20px; }
    .client-projects-heading p { color: #71717a; font-size: 14px; margin: 0; }
    .client-project-card { position: relative; display: grid; grid-template-columns: 72px 1fr 28px; gap: 24px; align-items: center; padding: 28px; border: 1px solid #27272a; background: #0c0c0f; color: inherit; transition: border-color .25s ease, background .25s ease, transform .25s ease; }
    .client-project-card:hover { border-color: #52525b; background: #101014; transform: translateY(-2px); }
    .client-project-logo { width: 64px; height: 64px; display: grid; place-items: center; border: 1px solid #3f3f46; border-radius: 14px; background: #f4f4f5; }
    .client-project-logo img { display: block; width: 52px; height: 52px; }
    .client-project-copy .work-meta { margin-bottom: 12px; }
    .client-project-copy h3 { margin: 0 0 8px; font-size: clamp(28px, 4vw, 42px); letter-spacing: -.05em; line-height: 1; }
    .client-project-copy p { margin: 0 0 16px; max-width: 780px; color: #a1a1aa; font-size: 15px; line-height: 1.7; }
    .client-project-copy .work-tags { margin-top: 0; }
    .work-meta { display: flex; justify-content: space-between; color: #71717a; font: 10px var(--font-mono); letter-spacing: .1em; }
    .work-status { color: #a1a1aa; }
    .work-status i { width: 6px; height: 6px; border-radius: 50%; background: #a1a1aa; display: inline-block; margin-right: 5px; }
    .work-status.live i { background: #4ade80; box-shadow: 0 0 7px rgba(74,222,128,.5); }
    .work-tags { display: flex; gap: 8px; flex-wrap: wrap; }
    .work-tags span { border: 1px solid #3f3f46; padding: 6px 10px; color: #71717a; font: 10px var(--font-mono); }
    .client-marquee { margin-top: 18px; overflow: hidden; border: 1px solid #27272a; background: #0c0c0f; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
    .client-marquee-track { display: flex; width: max-content; animation: client-marquee-scroll 24s linear infinite; }
    .client-marquee-item { display: flex; align-items: center; gap: 16px; min-width: 290px; padding: 16px 32px; color: #71717a; font: 11px var(--font-mono); letter-spacing: .12em; white-space: nowrap; }
    .client-marquee-item img { width: 42px; height: 42px; object-fit: contain; filter: grayscale(1); opacity: .75; }
    @keyframes client-marquee-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    @media(max-width:760px){
        .client-projects { margin-top: 52px; }
        .client-projects-heading { display: block; }
        .client-projects-heading p { margin-top: 14px; }
        .client-project-card { grid-template-columns: 56px 1fr; gap: 16px; padding: 20px; }
        .client-project-logo { width: 52px; height: 52px; }
        .client-project-logo img { width: 42px; height: 42px; }
    }
    @media(max-width:480px){
        .client-projects { margin-top: 44px; }
        .client-project-card { padding: 16px; gap: 12px; }
        .client-project-copy h3 { font-size: 28px; }
        .client-project-copy p { font-size: 13px; }
        .client-project-logo { width: 48px; height: 48px; }
        .client-project-logo img { width: 38px; height: 38px; }
        .client-marquee-item { min-width: 240px; padding: 13px 20px; font-size: 9px; }
        .client-marquee-item img { width: 36px; height: 36px; }
    }
    @media(prefers-reduced-motion:reduce){
        .client-marquee-track { animation: none; }
    }
</style>
