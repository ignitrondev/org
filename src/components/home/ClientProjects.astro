---
import C from '../C.astro';

const base = import.meta.env.BASE_URL;

const clients = [
    { logo: 'logo-ajy.png', name: 'ABYZAIN JAYA TEKNIKA' },
    { logo: 'logo-ra-mark.svg', name: 'RIZQI BAROKAH BUNDA · INVENTORY & BOM' },
    { logo: 'logo-rsia-gladiool.png', name: 'RSIA GLADIOOL · GLADIOOL EMR' },
    { logo: 'logo-yamaha.jpg', name: 'BOOKING YAMAHA SYSTEM' },
    { logo: 'logo-cashflow.jpg', name: 'GRACEFUL DECORATION · CASHFLOW' },
    { logo: 'logo-inventory-web.png', name: 'ZOYA COOKIES · INVENTORY' },
    { logo: 'logo-hamstore.webp', name: 'HAMSTORE CELL & SERVICE · KONTER HQ' },
];
---

<section class="section clients" id="clients">
    <div class="container">
        <div class="sec-head">
            <div>
                <p class="sec-kicker"><b>[03]</b><C en="Client projects" id="Proyek klien" zh="客户项目" /></p>
                <h2 class="sec-title"><C en="Built around" id="Dibangun mengikuti" zh="围绕真实团队" /><br /><span class="text-gradient"><C en="real teams." id="tim nyata." zh="而构建。" /></span></h2>
            </div>
            <p class="sec-lede"><C en="Custom systems built around the day-to-day work of real teams." id="Sistem kustom yang dibangun mengikuti pekerjaan harian tim nyata." zh="围绕真实团队日常工作构建的定制系统。" /></p>
        </div>

        <div class="engage-grid">
            <article class="engage-card">
                <div class="engage-top">
                    <div class="engage-logo"><img src={`${base}images/logo-rsia-gladiool.png`} alt="RSIA Gladiool logo" width="48" height="48" /></div>
                    <div class="work-meta"><span>CLIENT ENGAGEMENT / 01</span><span class="work-status live"><i></i>IN PRODUCTION</span></div>
                </div>
                <p class="engage-client">RSIA GLADIOOL</p>
                <h3>Gladiool EMR</h3>
                <p class="engage-body"><C en="Enterprise EMR platform for RSIA Gladiool, delivered through Gantha Studio. I handle backend, frontend, and the production infrastructure with Kubernetes and Argo CD." id="Platform EMR enterprise untuk RSIA Gladiool melalui Gantha Studio. Saya menangani backend, frontend, serta infrastruktur production dengan Kubernetes dan Argo CD." zh="通过 Gantha Studio 为 RSIA Gladiool 交付的企业级 EMR 平台。我负责后端、前端，以及使用 Kubernetes 和 Argo CD 的生产基础设施。" /></p>
                <div class="tag-list"><span>Backend</span><span>Frontend</span><span>Kubernetes</span><span>Argo CD</span></div>
            </article>

            <article class="engage-card">
                <div class="engage-top">
                    <div class="engage-logo"><img src={`${base}images/logo-hamstore.webp`} alt="Hamstore Cell &amp; Service logo" width="48" height="48" /></div>
                    <div class="work-meta"><span>CLIENT ENGAGEMENT / 02</span><span class="work-status"><i></i>IN DEVELOPMENT</span></div>
                </div>
                <p class="engage-client">HAMSTORE CELL &amp; SERVICE</p>
                <h3>Konter HQ</h3>
                <p class="engage-body"><C en="Multi-branch point-of-sale and operations system for Hamstore Cell & Service, bringing inventory, sales, cash, service orders, and reporting across every store branch into one place. Built as a NestJS modular monolith with clean architecture, a React frontend, and PostgreSQL." id="Sistem point-of-sale dan operasional multi-cabang untuk Hamstore Cell & Service yang menyatukan inventaris, penjualan, kas, order servis, dan laporan dari semua cabang toko. Dibangun sebagai modular monolith NestJS dengan clean architecture, frontend React, dan PostgreSQL." zh="为 Hamstore Cell & Service 打造的多门店收银与运营系统，将各门店的库存、销售、现金、维修订单和报表集中到一处。采用整洁架构的 NestJS 模块化单体、React 前端和 PostgreSQL 构建。" /></p>
                <div class="tag-list"><span>Point of Sale</span><span>NestJS</span><span>React</span><span>PostgreSQL</span></div>
            </article>
        </div>

        <div class="client-strip">
            <p class="client-strip-label"><C en="Systems delivered for" id="Sistem yang kami bangun untuk" zh="我们服务过的客户" /></p>
            <div class="client-marquee" aria-label={`Client logos: ${clients.map((client) => client.name.split(' · ')[0]).join(', ')}`}>
                <div class="client-marquee-track">
                    {[...clients, ...clients].map((client, i) => (
                        <div class="client-marquee-item" aria-hidden={i >= clients.length ? 'true' : undefined}>
                            <img src={`${base}images/${client.logo}`} alt="" width="40" height="40" loading="lazy" />
                            <span>{client.name}</span>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .engage-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .engage-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        padding: 28px;
        border: 1px solid var(--line-strong);
        background: var(--bg-raised);
        transition: border-color var(--transition-base);
    }

    .engage-card:hover {
        border-color: var(--line-bright);
    }

    .engage-top {
        display: flex;
        align-items: flex-start;
        gap: 18px;
    }

    .engage-top .work-meta {
        flex: 1;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 10px;
        color: var(--text-3);
        font: 500 10px/1 var(--font-mono);
        letter-spacing: 0.12em;
    }

    .work-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--text-2);
    }

    .work-status i {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--text-3);
    }

    .work-status.live {
        color: var(--ok);
    }

    .work-status.live i {
        background: var(--ok);
        box-shadow: 0 0 8px rgba(74, 222, 128, 0.6);
    }

    .engage-logo {
        width: 56px;
        height: 56px;
        flex: none;
        display: grid;
        place-items: center;
        overflow: hidden;
        background: #f4f4f5;
    }

    .engage-logo img {
        width: 46px;
        height: 46px;
        object-fit: contain;
    }

    .engage-client {
        margin-top: 64px;
        color: var(--accent);
        font: 500 10px/1 var(--font-mono);
        letter-spacing: 0.14em;
    }

    .engage-card h3 {
        margin: 14px 0 14px;
        font-size: clamp(32px, 3.6vw, 44px);
        font-weight: 600;
        line-height: 1;
        letter-spacing: -0.05em;
    }

    .engage-body {
        margin-bottom: 28px;
        color: var(--text-2);
        font-size: 15px;
        line-height: 1.7;
    }

    .engage-card .tag-list {
        margin-top: auto;
    }

    /* Logo strip */
    .client-strip {
        margin-top: 16px;
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        border: 1px solid var(--line-strong);
    }

    .client-strip-label {
        display: flex;
        align-items: center;
        padding: 0 20px;
        border-right: 1px solid var(--line);
        color: var(--text-3);
        font: 500 10px/1.5 var(--font-mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .client-marquee {
        overflow: hidden;
        mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    }

    .client-marquee-track {
        display: flex;
        width: max-content;
        animation: client-marquee-scroll 40s linear infinite;
    }

    .client-marquee:hover .client-marquee-track {
        animation-play-state: paused;
    }

    .client-marquee-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 28px;
        border-right: 1px solid var(--line);
        color: var(--text-3);
        font: 500 10.5px/1 var(--font-mono);
        letter-spacing: 0.1em;
        white-space: nowrap;
        transition: color var(--transition-fast);
    }

    .client-marquee-item img {
        width: 36px;
        height: 36px;
        padding: 3px;
        object-fit: contain;
        background: #f4f4f5;
        filter: grayscale(1);
        opacity: 0.6;
        transition: filter var(--transition-fast), opacity var(--transition-fast);
    }

    .client-marquee-item:hover {
        color: var(--text);
    }

    .client-marquee-item:hover img {
        filter: none;
        opacity: 1;
    }

    @keyframes client-marquee-scroll {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }

    @media (max-width: 900px) {
        .engage-grid {
            grid-template-columns: 1fr;
        }

        .client-strip {
            grid-template-columns: 1fr;
        }

        .client-strip-label {
            padding: 14px 16px;
            border-right: 0;
            border-bottom: 1px solid var(--line);
        }
    }

    @media (max-width: 480px) {
        .engage-card {
            padding: 20px;
        }

        .engage-top {
            flex-direction: column;
        }

        .engage-client {
            margin-top: 32px;
        }

        .client-marquee-item {
            padding: 14px 20px;
            font-size: 9.5px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .client-marquee-track {
            animation: none;
        }
    }
</style>
