---
import C from '../C.astro';
---

<div class="section-header work-header">
    <div>
        <span class="section-badge"><C en="Products and public work" id="Produk dan karya publik" zh="产品与公开作品" /></span>
        <h2 class="section-title"><C en="Proof lives in" id="Buktinya ada pada" zh="证据存在于" /> <span class="text-gradient"><C en="what we run." id="apa yang kami jalankan." zh="我们运行的事物中。" /></span></h2>
    </div>
    <p class="section-subtitle"><C en="Independent products and open-source building blocks provide a concrete place to test ideas about interfaces, operations, data, and technical systems." id="Produk independen dan building block open-source menjadi tempat konkret untuk menguji ide tentang interface, operasi, data, dan sistem teknis." zh="独立产品与开源构件为测试接口、运营、数据与技术系统的想法提供了具体场所。" /></p>
</div>

<div class="work-grid">
    <article class="work-card product-card" id="products">
        <div class="work-card-copy">
            <div class="work-meta"><span>PRODUCT / 01</span><span class="work-status live"><i></i> LIVE</span></div>
            <div>
                <p class="work-eyebrow">MARITIME SOFTWARE</p>
                <h3>ShipRadar</h3>
                <p><C en="A maritime vessel-tracking platform for monitoring ships, routes, and fleet activity through a focused operational interface." id="Platform pelacakan kapal untuk memantau kapal, rute, dan aktivitas armada melalui interface operasional yang terfokus." zh="面向船舶、航线与船队活动监控的海事追踪平台，提供专注的运营界面。" /></p>
            </div>
            <div class="work-tags"><span>Vessel tracking</span><span>AIS data</span><span>Fleet operations</span></div>
            <a href="https://shipradar.my.id" target="_blank" rel="noopener noreferrer" class="work-link"><C en="Visit ShipRadar" id="Kunjungi ShipRadar" zh="访问 ShipRadar" /> <span>↗</span></a>
        </div>
        <div class="radar-visual" aria-hidden="true">
            <div class="radar-grid"></div>
            <div class="radar-ring ring-one"></div><div class="radar-ring ring-two"></div><div class="radar-ring ring-three"></div>
            <div class="radar-axis horizontal"></div><div class="radar-axis vertical"></div>
            <div class="radar-sweep-line"></div>
            <i class="vessel vessel-one"></i><i class="vessel vessel-two"></i><i class="vessel vessel-three"></i>
            <span class="radar-label top">06°12' S</span><span class="radar-label bottom">106°49' E</span>
        </div>
    </article>

    <article class="work-card router-card">
        <div class="work-card-copy">
            <div class="work-meta"><span>PRODUCT / 02</span><span class="work-status live"><i></i> LIVE</span></div>
            <div>
                <p class="work-eyebrow">AI INFRASTRUCTURE</p>
                <h3>IgnitronDev Router</h3>
                <p><C en="A unified AI gateway for routing requests to leading models through one API key, with built-in usage metering, billing, and spend controls." id="Gateway AI terpadu untuk merutekan request ke model terdepan melalui satu API key, dilengkapi metering penggunaan, billing, dan kontrol biaya." zh="统一 AI 网关，通过一个 API 密钥将请求路由至领先模型，并内置用量计量、账单与费用控制。" /></p>
            </div>
            <div class="work-tags"><span>AI gateway</span><span>Unified API</span><span>Usage metering</span><span>Spend controls</span></div>
            <a href="https://app.ignitrondev.space" target="_blank" rel="noopener noreferrer" class="work-link"><C en="Open IgnitronDev Router" id="Buka IgnitronDev Router" zh="打开 IgnitronDev Router" /> <span>↗</span></a>
        </div>
        <div class="router-visual" aria-hidden="true">
            <div class="router-console">
                <header><span>AI ROUTER / LIVE</span><span class="router-live"><i></i> OPERATIONAL</span></header>
                <div class="router-request"><span>POST</span><code>/v1/messages</code><small>ONE API KEY</small></div>
                <div class="router-flow">
                    <div class="router-source"><small>YOUR APP</small><strong>REQUEST</strong></div>
                    <div class="router-path"><i></i><i></i><i></i></div>
                    <div class="router-core"><small>IGNITRONDEV</small><strong>ROUTER</strong><span>AUTH · ROUTE · METER</span></div>
                    <div class="router-path outbound"><i></i><i></i><i></i></div>
                    <div class="router-models"><span>ANTHROPIC</span><span>OPENAI</span><span>GOOGLE</span></div>
                </div>
                <footer><span><b>1</b><small>endpoint</small></span><span><b>1</b><small>API key</small></span><span><b>∞</b><small>possibilities</small></span></footer>
            </div>
        </div>
    </article>

    <article class="work-card open-source-card" id="open-source">
        <div class="work-card-copy">
            <div class="work-meta"><span>OPEN SOURCE / 01</span><span class="work-status"><i></i> ALPHA</span></div>
            <div>
                <p class="work-eyebrow">CLINICAL SOFTWARE INFRASTRUCTURE</p>
                <h3>Ignitron Clinical UI</h3>
                <p><C en="Reusable React components for difficult clinical workflows, built around explicit data contracts and clear integration boundaries." id="Komponen React reusable untuk workflow klinis yang sulit, dibangun di atas kontrak data eksplisit dan batas integrasi yang jelas." zh="面向复杂临床工作流的可复用 React 组件，采用显式数据契约与清晰集成边界。" /></p>
            </div>
            <div class="work-tags"><span>React</span><span>TypeScript</span><span>Clinical data</span><span>Apache-2.0</span></div>
            <div class="work-actions">
                <a href="https://ignitron-medic-ui.pages.dev/" target="_blank" rel="noopener noreferrer" class="work-link"><C en="Read the docs" id="Buka dokumentasi" zh="阅读文档" /> <span>↗</span></a>
                <a href="https://www.npmjs.com/package/@ignitrondev/odontogram" target="_blank" rel="noopener noreferrer" class="work-link muted">npm ↗</a>
            </div>
        </div>
        <div class="package-visual" aria-label="Odontogram package installation example">
            <header><span>PACKAGE / ALPHA</span><span>PUBLIC</span></header>
            <div class="package-name"><small>@ignitrondev/</small><strong>odontogram</strong></div>
            <div class="package-command"><span>$</span><code>npm install @ignitrondev/odontogram@alpha</code></div>
            <div class="package-stats"><span><b>React</b><small>18 / 19</small></span><span><b>ESM</b><small>typed</small></span><span><b>0</b><small>telemetry</small></span></div>
        </div>
    </article>

    <article class="work-card volcano-card">
        <div class="work-card-copy">
            <div class="work-meta"><span>PRODUCT / 03</span><span class="work-status live"><i></i> LIVE</span></div>
            <div>
                <p class="work-eyebrow">VOLCANO OBSERVATORY</p>
                <h3>IGN Volcano</h3>
                <p><C en="A focused observatory for tracking volcanic activity across Indonesia, with an interactive map, current alert levels, and weather at each volcano location." id="Observatorium terfokus untuk memantau aktivitas gunung api di Indonesia, dengan peta interaktif, level status terkini, dan cuaca di tiap lokasi gunung." zh="一个专注于追踪印度尼西亚火山活动的观测平台，提供交互地图、当前警戒等级与各火山位置天气。" /></p>
            </div>
            <div class="work-tags"><span>Volcano monitoring</span><span>Interactive map</span><span>Activity status</span><span>Indonesia</span></div>
            <a href="https://magma.ignitrondev.space" target="_blank" rel="noopener noreferrer" class="work-link"><C en="Open IGN Volcano" id="Buka IGN Volcano" zh="打开 IGN Volcano" /> <span>↗</span></a>
        </div>
        <div class="volcano-visual" aria-hidden="true">
            <div class="volcano-grid"></div>
            <div class="volcano-console">
                <header><span>IGN VOLCANO / LIVE</span><span class="volcano-live"><i></i> MONITORING</span></header>
                <div class="volcano-map-lines"><i></i><i></i><i></i><i></i></div>
                <div class="volcano-peak"><span class="volcano-glow"></span><span class="volcano-plume"></span></div>
                <div class="volcano-markers"><i></i><i></i><i></i><i></i><i></i></div>
                <footer><span>INDONESIA</span><span>VOLCANIC ACTIVITY</span><b>● LIVE</b></footer>
            </div>
        </div>
    </article>
</div>

<style>
    .work-header { display: grid; grid-template-columns: 1fr .72fr; gap: 80px; align-items: end; }
    .work-grid { display: grid; gap: 22px; }
    .work-card { min-width:0;min-height:540px;display:grid;grid-template-columns:1.05fr .95fr;border:1px solid #27272a;background:#0c0c0f;overflow:hidden;scroll-margin-top:110px; }
    .work-card-copy { min-width:0;padding:36px;display:flex;flex-direction:column;justify-content:space-between;gap:40px; }
    .work-meta { display: flex; justify-content: space-between; color: #71717a; font: 10px var(--font-mono); letter-spacing: .1em; }
    .work-status { color: #a1a1aa; }
    .work-status i { width: 6px; height: 6px; border-radius: 50%; background: #a1a1aa; display: inline-block; margin-right: 5px; }
    .work-status.live i { background: #4ade80; box-shadow: 0 0 7px rgba(74,222,128,.5); }
    .work-eyebrow { color: #71717a !important; font: 10px var(--font-mono); letter-spacing: .14em; margin-bottom: 10px; }
    .work-card h3 { font-size: clamp(40px, 5vw, 68px); letter-spacing: -.055em; line-height: 1; margin-bottom: 18px; }
    .work-card p { color: #a1a1aa; font-size: 16px; line-height: 1.75; max-width: 690px; }
    .work-tags { display: flex; gap: 8px; flex-wrap: wrap; }.work-tags span { border: 1px solid #3f3f46; padding: 6px 10px; color: #71717a; font: 10px var(--font-mono); }
    .work-link { width: fit-content; display: inline-flex; align-items: center; gap: 10px; border-bottom: 1px solid #a1a1aa; padding-bottom: 5px; font-weight: 600; }.work-link span { transition: transform .2s ease; }.work-link:hover span { transform: translate(3px,-3px); }.work-link.muted { color: #a1a1aa; }
    .work-actions { display: flex; gap: 22px; flex-wrap: wrap; }

    /* Radar visualizer */
    .radar-visual { position:relative;min-width:0;min-height:540px;overflow:hidden;background:#101014;border-left:1px solid #27272a; }
    .radar-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px); background-size: 32px 32px; }
    .radar-ring { position: absolute; left: 50%; top: 50%; border: 1px solid #3f3f46; border-radius: 50%; transform: translate(-50%,-50%); animation: ring-pulse 4s ease-in-out infinite; }.ring-one{width:180px;height:180px;animation-delay:0s}.ring-two{width:330px;height:330px;animation-delay:1.3s}.ring-three{width:480px;height:480px;animation-delay:2.6s}
    .radar-axis { position: absolute; background: #3f3f46; }.radar-axis.horizontal{height:1px;left:0;right:0;top:50%}.radar-axis.vertical{width:1px;top:0;bottom:0;left:50%}
    .vessel { position: absolute; width: 8px; height: 13px; border: 1px solid #f4f4f5; background: #27272a; clip-path: polygon(50% 0,100% 35%,80% 100%,20% 100%,0 35%); }.vessel-one{left:67%;top:31%}.vessel-two{left:29%;top:62%}.vessel-three{left:57%;top:72%}
    .radar-label { position: absolute; color:#52525b;font:9px var(--font-mono);letter-spacing:.08em}.radar-label.top{top:18px;left:18px}.radar-label.bottom{bottom:18px;right:18px}
    .radar-sweep-line { position: absolute; left: 50%; top: 50%; width: 240px; height: 1px; background: linear-gradient(90deg, rgba(244,244,245,.7), rgba(244,244,245,.05)); transform-origin: 0 0; animation: radar-spin 8s linear infinite; }
    @keyframes radar-spin { to { transform: rotate(360deg); } }
    @keyframes ring-pulse { 0%,100% { opacity: .35; } 50% { opacity: 1; } }

    /* Router console visualizer */
    .router-visual { min-width:0;min-height:540px;display:grid;place-items:center;padding:36px;overflow:hidden;background:#101014;border-left:1px solid #27272a;background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);background-size:32px 32px; }
    .router-console { width:100%;max-width:560px;border:1px solid #3f3f46;background:rgba(9,9,11,.96);box-shadow:0 30px 70px rgba(0,0,0,.5);font-family:var(--font-mono); }
    .router-console header { display:flex;justify-content:space-between;gap:16px;padding:14px 16px;border-bottom:1px solid #27272a;color:#71717a;font-size:10px;letter-spacing:.08em; }
    .router-live { color:#a1a1aa; }.router-live i { width:6px;height:6px;display:inline-block;margin-right:5px;border-radius:50%;background:#4ade80;box-shadow:0 0 7px rgba(74,222,128,.5);animation:status-pulse 2.4s ease-in-out infinite; }
    .router-request { display:flex;align-items:center;gap:10px;margin:22px;padding:13px 14px;border:1px solid #27272a;background:#18181b;font-size:11px; }.router-request>span{color:#09090b;background:#f4f4f5;padding:3px 6px;font-weight:700}.router-request code{color:#d4d4d8}.router-request small{margin-left:auto;color:#52525b;letter-spacing:.08em}
    .router-flow { display:grid;grid-template-columns:1fr 32px 1.35fr 32px 1fr;align-items:center;padding:26px 22px 34px; }
    .router-source,.router-core { text-align:center;border:1px solid #3f3f46;background:#101014;padding:17px 10px; }.router-source small,.router-core small{display:block;color:#52525b;font-size:8px;letter-spacing:.1em}.router-source strong,.router-core strong{display:block;margin-top:5px;font-size:12px;letter-spacing:.08em}.router-core{border-color:#71717a;box-shadow:0 0 24px rgba(255,255,255,.05)}.router-core span{display:block;margin-top:8px;color:#71717a;font-size:7px;letter-spacing:.06em}
    .router-path { position:relative;height:1px;background:#52525b; }.router-path::after{content:'›';position:absolute;right:-2px;top:50%;color:#a1a1aa;font-size:15px;transform:translateY(-54%)}.router-path i{position:absolute;top:-2px;width:5px;height:5px;border-radius:50%;background:#d4d4d8;animation:route-packet 2.2s linear infinite}.router-path i:nth-child(2){animation-delay:.7s}.router-path i:nth-child(3){animation-delay:1.4s}.router-path.outbound i{animation-delay:.3s}.router-path.outbound i:nth-child(2){animation-delay:1s}.router-path.outbound i:nth-child(3){animation-delay:1.7s}
    .router-models { display:grid;gap:7px; }.router-models span{border:1px solid #27272a;background:#101014;padding:8px 6px;color:#a1a1aa;text-align:center;font-size:8px;letter-spacing:.06em}
    .router-console footer { display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #27272a; }.router-console footer span{padding:16px;border-right:1px solid #27272a;text-align:center}.router-console footer span:last-child{border:0}.router-console footer b,.router-console footer small{display:block}.router-console footer b{font-size:15px}.router-console footer small{margin-top:3px;color:#71717a;font-size:8px;letter-spacing:.06em}
    @keyframes status-pulse { 0%,100% { transform: scale(.85); opacity: .55; } 50% { transform: scale(1.25); opacity: 1; } }
    @keyframes route-packet { from{left:0;opacity:0}20%{opacity:1}80%{opacity:1}to{left:calc(100% - 5px);opacity:0} }

    /* Open Source / Package visual */
    .package-visual { min-width:0;max-width:100%;align-self:center;margin:36px;border:1px solid #3f3f46;background:#09090b;box-shadow:0 30px 70px rgba(0,0,0,.45); }
    .package-visual header { display:flex;justify-content:space-between;padding:14px 16px;border-bottom:1px solid #27272a;color:#71717a;font:10px var(--font-mono); }
    .package-name { padding: 54px 30px 40px; }.package-name small,.package-name strong { display:block; }.package-name small { color:#71717a;font:14px var(--font-mono); }.package-name strong { font-size:clamp(30px,4vw,50px);letter-spacing:-.05em; }
    .package-command { margin:0 30px 30px;padding:16px;background:#18181b;border:1px solid #27272a;display:flex;gap:10px;overflow-x:auto;font:11px var(--font-mono);white-space:nowrap}.package-command span{color:#71717a}.package-command code{color:#d4d4d8}
    .package-stats { display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #27272a}.package-stats span{padding:18px;border-right:1px solid #27272a}.package-stats span:last-child{border:0}.package-stats b,.package-stats small{display:block}.package-stats b{font:14px var(--font-mono)}.package-stats small{color:#71717a;font-size:10px;margin-top:4px}

    /* Volcano visualizer */
    .volcano-visual { position:relative;min-width:0;min-height:540px;overflow:hidden;border-left:1px solid #27272a;background:#100d0c; }
    .volcano-grid { position:absolute;inset:0;background-image:linear-gradient(rgba(255,154,73,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(255,154,73,.055) 1px,transparent 1px);background-size:32px 32px;mask-image:linear-gradient(to bottom,#000,transparent 90%); }
    .volcano-console { position:absolute;inset:50px 36px;border:1px solid #5a3830;background:rgba(14,12,12,.9);box-shadow:0 30px 70px rgba(0,0,0,.48);font-family:var(--font-mono);overflow:hidden; }
    .volcano-console header,.volcano-console footer { position:absolute;left:0;right:0;z-index:3;display:flex;justify-content:space-between;gap:10px;padding:14px 16px;color:#a8867b;font-size:10px;letter-spacing:.08em; }
    .volcano-console header { top:0;border-bottom:1px solid #402c28; }.volcano-console footer { bottom:0;border-top:1px solid #402c28;font-size:8px; }.volcano-console footer b { color:#fb6d47;font-weight:500; }.volcano-live { color:#e5a08b; }.volcano-live i { display:inline-block;width:6px;height:6px;margin-right:5px;border-radius:50%;background:#fb6d47;box-shadow:0 0 8px rgba(251,109,71,.7);animation:status-pulse 2.4s ease-in-out infinite; }
    .volcano-map-lines { position:absolute;inset:65px 0 45px;opacity:.58;background:linear-gradient(154deg,transparent 42%,#563733 42.3%,transparent 42.7%),linear-gradient(31deg,transparent 47%,#563733 47.3%,transparent 47.7%),linear-gradient(118deg,transparent 53%,#563733 53.3%,transparent 53.7%); }.volcano-map-lines i { position:absolute;width:180%;height:1px;background:#563733;transform:rotate(var(--r));left:-35%;top:var(--t); }.volcano-map-lines i:nth-child(1){--r:12deg;--t:20%}.volcano-map-lines i:nth-child(2){--r:-16deg;--t:43%}.volcano-map-lines i:nth-child(3){--r:8deg;--t:66%}.volcano-map-lines i:nth-child(4){--r:-9deg;--t:81%}
    .volcano-peak { position:absolute;z-index:2;bottom:44px;left:50%;width:220px;height:190px;transform:translateX(-50%);clip-path:polygon(50% 0,100% 100%,0 100%);background:linear-gradient(120deg,#241918,#6d3328 56%,#2b1a18); }.volcano-peak::after { content:'';position:absolute;top:21px;left:40%;width:42px;height:14px;border-radius:50%;background:#110c0b;box-shadow:0 0 20px 7px rgba(251,109,71,.35); }.volcano-glow { position:absolute;left:50%;top:14px;width:16px;height:16px;border-radius:50%;background:#ffb05b;box-shadow:0 0 45px 19px rgba(251,109,71,.55);transform:translateX(-50%);animation:volcano-glow 2.8s ease-in-out infinite; }.volcano-plume { position:absolute;left:50%;bottom:145px;width:66px;height:114px;border-radius:50% 50% 35% 35%;background:radial-gradient(ellipse at bottom,rgba(255,161,105,.34),rgba(98,58,53,.12) 52%,transparent 72%);transform:translateX(-50%);filter:blur(5px);animation:plume-rise 4s ease-in-out infinite; }
    .volcano-markers i { position:absolute;z-index:2;width:8px;height:8px;border:1px solid #ffd4bd;border-radius:50%;background:#fb6d47;box-shadow:0 0 10px rgba(251,109,71,.8); }.volcano-markers i:nth-child(1){left:20%;top:36%}.volcano-markers i:nth-child(2){left:72%;top:29%}.volcano-markers i:nth-child(3){left:67%;top:61%}.volcano-markers i:nth-child(4){left:28%;top:70%}.volcano-markers i:nth-child(5){left:45%;top:45%}
    @keyframes volcano-glow { 0%,100%{opacity:.65;transform:translateX(-50%) scale(.8)}50%{opacity:1;transform:translateX(-50%) scale(1.25)} }
    @keyframes plume-rise { 0%,100%{transform:translate(-50%,8px) scale(.8);opacity:.45}50%{transform:translate(-50%,-12px) scale(1.15);opacity:.9} }

    @media(max-width:1000px){
        .work-card { grid-template-columns: 1fr; }
        .work-header { grid-template-columns: 1fr; gap: 22px; }
        .radar-visual, .router-visual, .volcano-visual { border-left: 0; border-top: 1px solid #27272a; min-height: 450px; }
        .package-visual { width: calc(100% - 72px); }
    }
    @media(max-width:760px){
        .work-card { min-height: 0; }
        .work-card-copy { padding: 24px; }
        .radar-visual, .router-visual, .volcano-visual { min-height: 360px; }
        .router-visual { padding: 24px; }
        .volcano-console { inset: 32px 24px; }
        .ring-three { width: 360px; height: 360px; }
        .package-visual { margin: 24px; width: calc(100% - 48px); }
        .package-name { padding: 40px 20px 30px; }
        .package-command { margin: 0 20px 20px; }
        .package-stats span { padding: 14px 10px; }
    }
    @media(max-width:480px){
        .work-card { scroll-margin-top: 96px; min-height: 0; }
        .work-card-copy { padding: 16px; gap: 24px; }
        .work-meta { gap: 8px; flex-wrap: wrap; font-size: 9px; }
        .work-card h3 { font-size: clamp(29px, 9.5vw, 38px); overflow-wrap: anywhere; }
        .work-card p { font-size: 14px; line-height: 1.6; }
        .work-tags { gap: 6px; }
        .work-tags span { padding: 5px 8px; font-size: 9px; }
        .work-actions { gap: 12px; }
        .radar-visual { min-height: 280px; }
        .router-visual { min-height: 300px; padding: 10px; }
        .router-console header { padding: 11px 12px; font-size: 8px; }
        .router-request { margin: 10px; padding: 10px 11px; font-size: 9px; }
        .router-request small { display: none; }
        .router-flow { grid-template-columns: 1fr 16px 1.2fr 16px 1fr; padding: 16px 9px 20px; }
        .router-source, .router-core { padding: 10px 3px; }
        .router-source small, .router-core small { font-size: 6px; }
        .router-source strong, .router-core strong { font-size: 8px; }
        .router-core span { font-size: 5px; }
        .router-models { gap: 5px; }
