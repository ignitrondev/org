---
import { langLabels, type Lang } from '../i18n/index';
---

<div class="lang-toggle" id="langToggle">
    {Object.entries(langLabels).map(([code, label]) => (
        <button class={`lang-btn ${code === 'en' ? 'active' : ''}`} data-lang={code}>{label}</button>
    ))}
</div>

<script>
    // Language toggle logic — client-side translation via data-i18n attributes
    const STORAGE_KEY = 'ignitron-lang';

    function getLang(): string {
        return localStorage.getItem(STORAGE_KEY) || 'en';
    }

    function setLang(lang: string) {
        localStorage.setItem(STORAGE_KEY, lang);
        document.documentElement.setAttribute('data-lang', lang);
        updateUI(lang);
        // Notify other scripts (e.g. Hero typewriter) to re-run with new lang
        document.dispatchEvent(new CustomEvent('ignitron:lang-changed', { detail: { lang } }));
    }

    function updateUI(lang: string) {
        // Update toggle buttons
        document.querySelectorAll('.lang-btn').forEach(btn => {
            btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
        });

        // Update all elements with data-i18n attributes.
        // Only target leaf nodes (no children with attributes) to preserve icons/svgs alongside text.
        document.querySelectorAll('[data-i18n]').forEach(el => {
            // If element has child elements, translate those instead (typically the <T> span we author)
            const targetChildren = el.querySelectorAll(':scope [data-i18n]');
            const nodes = targetChildren.length > 0 ? targetChildren : [el];
            nodes.forEach(node => {
                // Don't replace if this node contains element children (icons, svgs) — set innerText only on the first text node
                const hasElementChildren = node.children.length > 0;
                if (hasElementChildren) {
                    // Walk text nodes, replace only direct text nodes
                    const translation = node.getAttribute(`data-t-${lang}`);
                    if (!translation) return;
                    const textNode = Array.from(node.childNodes).find(n => n.nodeType === Node.TEXT_NODE);
                    if (textNode) textNode.textContent = translation;
                    else node.prepend(document.createTextNode(translation));
                } else {
                    const translation = node.getAttribute(`data-t-${lang}`);
                    if (translation) node.textContent = translation;
                }
            });
        });

        // Show/hide language-specific content blocks
        document.querySelectorAll('[data-lang-content]').forEach(el => {
            const contentLang = el.getAttribute('data-lang-content');
            (el as HTMLElement).style.display = contentLang === lang ? 'block' : 'none';
        });

        // Update blog music toggle if exists
        document.querySelectorAll('.blog-lang-btn').forEach(btn => {
            const btnLang = btn.getAttribute('data-lang');
            // Map zh to en for music post (only has id/en)
            const mappedLang = lang === 'zh' ? 'en' : lang;
            btn.classList.toggle('active', btnLang === mappedLang);
        });
        // Trigger music content switch
        document.querySelectorAll('.blog-lang-content').forEach(el => {
            const contentLang = el.getAttribute('data-lang-content');
            const mappedLang = lang === 'zh' ? 'en' : lang;
            (el as HTMLElement).style.display = contentLang === mappedLang ? 'block' : 'none';
        });
    }

    // Init
    const savedLang = getLang();
    document.documentElement.setAttribute('data-lang', savedLang);

    // Wait for DOM
    document.addEventListener('DOMContentLoaded', () => {
        updateUI(savedLang);

        document.querySelectorAll('.lang-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const lang = this.getAttribute('data-lang');
                if (lang) setLang(lang);
            });
        });
    });
</script>

<style>
.lang-toggle {
    position: fixed;
    top: 20px;
    right: 24px;
    z-index: 1001;
    display: flex;
    gap: 4px;
    padding: 4px;
    background: rgba(17, 17, 27, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-color);
    border-radius: 100px;
}

.lang-btn {
    padding: 6px 12px;
    background: transparent;
    border: none;
    border-radius: 100px;
    color: var(--steel-silver);
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font-family);
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
}

.lang-btn:hover {
    color: var(--cyber-cyan);
}

.lang-btn.active {
    background: var(--cyber-cyan);
    color: var(--black);
}

@media (max-width: 768px) {
    .lang-toggle {
        top: auto;
        bottom: 20px;
        right: 50%;
        transform: translateX(50%);
    }
}
</style>
